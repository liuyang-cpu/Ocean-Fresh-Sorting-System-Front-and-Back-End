<UserControl x:Class="OceanFresh.SortingSystem.HMI.Pages.ChannelDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI">
  <Grid Background="{StaticResource SettingsEditorBackgroundBrush}" Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="20" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="18" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel LastChildFill="False">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource SettingsEditorReturnButtonStyle}" Margin="0,0,18,0" Command="{Binding BackToListCommand}">
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="16" Height="16" Margin="0,0,8,0">
              <Path Data="{StaticResource SettingsBackIconGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Viewbox>
            <TextBlock Text="返回列表" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <TextBlock Text="通道详情" Foreground="#EAF4FF" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource SettingsDetailEditButtonStyle}" Command="{Binding OpenEditCommand}">
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="16" Height="16" Margin="0,0,8,0">
              <Path Data="{StaticResource SettingsEditIconGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeLineJoin="Round" />
            </Viewbox>
            <TextBlock Text="编辑通道" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource SettingsDetailDangerButtonStyle}"
                Margin="12,0,0,0"
                Command="{Binding DeleteChannelCommand}"
                IsEnabled="{Binding CanDelete}">
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="16" Height="16" Margin="0,0,8,0">
              <Path Data="{StaticResource SettingsDeleteIconGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeLineJoin="Round" />
            </Viewbox>
            <TextBlock Text="删除通道" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </DockPanel>

    <Border Grid.Row="2" Style="{StaticResource SettingsEditorCardStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="54" />
          <RowDefinition Height="82" />
          <RowDefinition Height="82" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="132" />
          <ColumnDefinition Width="1.2*" />
          <ColumnDefinition Width="132" />
          <ColumnDefinition Width="1.2*" />
          <ColumnDefinition Width="132" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="6" Background="#123B5B" BorderBrush="#31506A" BorderThickness="0,0,0,1" Padding="18,0">
          <TextBlock Text="通道信息" Foreground="#EAF4FF" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Border>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="通道名称" Foreground="#8FA8C2" FontSize="14" Margin="18,0,0,0" VerticalAlignment="Center" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ChannelName}" Foreground="#EAF4FF" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock Grid.Row="1" Grid.Column="2" Text="通道编号" Foreground="#8FA8C2" FontSize="14" VerticalAlignment="Center" />
        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding ChannelNoLabel}" Foreground="#EAF4FF" FontSize="17" VerticalAlignment="Center" />
        <TextBlock Grid.Row="1" Grid.Column="4" Text="使用状态" Foreground="#8FA8C2" FontSize="14" VerticalAlignment="Center" />
        <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Width="9" Height="9" Fill="{Binding RunningStatusColor}" Margin="0,0,9,0" VerticalAlignment="Center" />
          <TextBlock Text="{Binding RunningStatus}" Foreground="{Binding RunningStatusColor}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <Border Grid.Row="2" Grid.ColumnSpan="6" BorderBrush="#21445F" BorderThickness="0,1,0,0" />
        <TextBlock Grid.Row="2" Grid.Column="0" Text="海鲜产品" Foreground="#8FA8C2" FontSize="14" Margin="18,0,0,0" VerticalAlignment="Center" />
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProductName}" Foreground="#25D89B" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock Grid.Row="2" Grid.Column="2" Text="绑定模型" Foreground="#8FA8C2" FontSize="14" VerticalAlignment="Center" />
        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding ModelVersion}" Foreground="#4CC3FF" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Border Grid.Row="4"
            Background="#2A2026"
            BorderBrush="#7C3A43"
            BorderThickness="1"
            CornerRadius="4"
            Padding="14,10"
            Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibilityConverter}}">
      <TextBlock Text="{Binding StatusMessage}" Foreground="#FFB6BE" FontSize="14" TextWrapping="Wrap" />
    </Border>
  </Grid>
</UserControl>
