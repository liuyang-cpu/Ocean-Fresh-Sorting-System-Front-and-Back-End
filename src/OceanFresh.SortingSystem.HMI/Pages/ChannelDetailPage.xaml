<UserControl x:Class="OceanFresh.SortingSystem.HMI.Pages.ChannelDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Border Background="{StaticResource PanelBackground}" CornerRadius="18" Padding="24">
      <StackPanel>
        <DockPanel Margin="0,0,0,18">
          <StackPanel>
            <TextBlock Text="通道详情" Foreground="{StaticResource TextBrush}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="查看通道当前绑定的海鲜、模型和运行状态，再决定启用或编辑。"
                       Foreground="{StaticResource MutedTextBrush}"
                       Margin="0,8,0,0" />
          </StackPanel>
          <Button DockPanel.Dock="Right"
                  Padding="16,10"
                  MinWidth="120"
                  Background="{StaticResource SurfaceBrush}"
                  Foreground="{StaticResource TextBrush}"
                  Command="{Binding BackToListCommand}">
            <TextBlock Text="返回通道列表" />
          </Button>
        </DockPanel>

        <Border Background="{StaticResource SurfaceSoftBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,18">
          <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
        </Border>

        <Grid Margin="0,0,0,18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Background="{StaticResource SurfaceSoftBrush}" CornerRadius="14" Padding="16" Margin="0,0,12,0">
            <StackPanel>
              <TextBlock Text="通道名称" Foreground="{StaticResource MutedTextBrush}" />
              <TextBlock Text="{Binding ChannelName}" Foreground="{StaticResource TextBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" />
              <TextBlock Text="{Binding ChannelNoLabel}" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Background="{StaticResource SurfaceSoftBrush}" CornerRadius="14" Padding="16" Margin="0,0,12,0">
            <StackPanel>
              <TextBlock Text="运行状态" Foreground="{StaticResource MutedTextBrush}" />
              <TextBlock Text="{Binding RunningStatus}" Foreground="{StaticResource TextBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Background="{StaticResource SurfaceSoftBrush}" CornerRadius="14" Padding="16">
            <StackPanel>
              <TextBlock Text="当前模型" Foreground="{StaticResource MutedTextBrush}" />
              <TextBlock Text="{Binding ModelVersion}" Foreground="{StaticResource TextBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
        </Grid>

        <Grid Margin="0,0,0,18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Background="{StaticResource SurfaceSoftBrush}" CornerRadius="14" Padding="16" Margin="0,0,12,0">
            <StackPanel>
              <TextBlock Text="海鲜产品" Foreground="{StaticResource MutedTextBrush}" />
              <TextBlock Text="{Binding ProductName}" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Background="{StaticResource SurfaceSoftBrush}" CornerRadius="14" Padding="16" Margin="0,0,12,0">
            <StackPanel>
              <TextBlock Text="缺陷动作" Foreground="{StaticResource MutedTextBrush}" />
              <TextBlock Text="{Binding DefectAction}" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Background="{StaticResource SurfaceSoftBrush}" CornerRadius="14" Padding="16">
            <StackPanel>
              <TextBlock Text="置信度阈值" Foreground="{StaticResource MutedTextBrush}" />
              <TextBlock Text="{Binding ConfidenceThreshold}" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
        </Grid>

        <StackPanel Orientation="Horizontal">
          <Button Padding="18,12"
                  Background="{StaticResource AccentBrush}"
                  Foreground="#08121B"
                  FontWeight="Bold"
                  MinWidth="120"
                  Command="{Binding ToggleChannelEnabledCommand}">
            <TextBlock Text="{Binding ToggleActionText}" />
          </Button>
          <Button Margin="12,0,0,0"
                  Padding="18,12"
                  Background="{StaticResource AccentMutedBrush}"
                  Foreground="#08121B"
                  FontWeight="Bold"
                  MinWidth="120"
                  Command="{Binding OpenEditCommand}">
            <TextBlock Text="编辑通道" />
          </Button>
          <Button Margin="12,0,0,0"
                  Padding="18,12"
                  Background="{StaticResource DangerBrush}"
                  Foreground="{StaticResource TextBrush}"
                  MinWidth="108"
                  Command="{Binding DeleteChannelCommand}">
            <TextBlock Text="删除通道" />
          </Button>
          <Button Margin="12,0,0,0"
                  Padding="18,12"
                  Background="{StaticResource SurfaceBrush}"
                  Foreground="{StaticResource TextBrush}"
                  MinWidth="108"
                  Command="{Binding BackToListCommand}">
            <TextBlock Text="返回列表" />
          </Button>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
