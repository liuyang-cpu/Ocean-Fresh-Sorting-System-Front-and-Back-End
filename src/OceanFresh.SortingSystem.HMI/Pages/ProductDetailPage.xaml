<UserControl x:Class="OceanFresh.SortingSystem.HMI.Pages.ProductDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI">
  <Grid Background="{StaticResource SettingsEditorBackgroundBrush}" Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="20" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel LastChildFill="False">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource SettingsEditorReturnButtonStyle}"
                Margin="0,0,18,0"
                Command="{Binding BackToListCommand}">
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="16" Height="16" Margin="0,0,8,0">
              <Path Data="{StaticResource SettingsBackIconGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Viewbox>
            <TextBlock Text="返回列表" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <TextBlock Text="海鲜产品详情"
                   Foreground="#EAF4FF"
                   FontSize="26"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource SettingsDetailEditButtonStyle}"
                Command="{Binding OpenEditCommand}">
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="16" Height="16" Margin="0,0,8,0">
              <Path Data="{StaticResource SettingsEditIconGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeLineJoin="Round" />
            </Viewbox>
            <TextBlock Text="编辑产品" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource SettingsDetailDangerButtonStyle}"
                Margin="12,0,0,0"
                Command="{Binding DeleteProductCommand}">
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="16" Height="16" Margin="0,0,8,0">
              <Path Data="{StaticResource SettingsDeleteIconGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeLineJoin="Round" />
            </Viewbox>
            <TextBlock Text="删除产品" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.9*" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="1.1*" />
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource SettingsEditorCardStyle}" Padding="22">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Text="产品信息" Style="{StaticResource SettingsEditorSectionTitleStyle}" />
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="18" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="海鲜名称" Foreground="#8FA9C1" FontSize="14" />
              <TextBlock Text="{Binding Name}" Foreground="#EAF4FF" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="产品编码" Foreground="#8FA9C1" FontSize="14" />
              <TextBlock Text="{Binding Code}" Foreground="#EAF4FF" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
            </StackPanel>
          </Grid>

          <StackPanel Grid.Row="4">
            <TextBlock Text="缺陷类型" Foreground="#8FA9C1" FontSize="14" Margin="0,0,0,10" />
            <ItemsControl ItemsSource="{Binding DefectTraits}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#0A2439" BorderBrush="#315873" BorderThickness="1" CornerRadius="4" Padding="14,7" Margin="0,0,10,8">
                    <TextBlock Text="{Binding}" Foreground="#DCEAF5" FontSize="15" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Grid.Row="6">
            <TextBlock Text="标签文件" Foreground="#8FA9C1" FontSize="14" Margin="0,0,0,10" />
            <Border Style="{StaticResource SettingsEditorInputFrameStyle}" Height="48" Padding="14,0,4,0">
              <DockPanel LastChildFill="True">
                <Viewbox DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,12,0">
                  <Path Data="{StaticResource SettingsFileIconGeometry}" Stroke="#79B9DF" StrokeThickness="1.7" StrokeLineJoin="Round" />
                </Viewbox>
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource SettingsEditorSecondaryButtonStyle}"
                        Height="38"
                        MinHeight="38"
                        MinWidth="102"
                        Padding="14,0"
                        FontSize="14"
                        Command="{Binding OpenClassesFileCommand}"
                        IsEnabled="{Binding HasClassesFile}">
                  <TextBlock Text="打开文件" />
                </Button>
                <TextBlock Text="{Binding ClassesFilePath}" Foreground="#DCEAF5" FontSize="14" Margin="0,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding ClassesFilePath}" />
              </DockPanel>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource SettingsEditorCardStyle}" Padding="22">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="标签映射" Style="{StaticResource SettingsEditorSectionTitleStyle}" />
          <DataGrid Grid.Row="2"
                    ItemsSource="{Binding LabelMappings}"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserResizeColumns="False"
                    IsReadOnly="True"
                    Style="{StaticResource SettingsListDataGridStyle}"
                    ColumnHeaderStyle="{StaticResource SettingsDetailTableHeaderStyle}"
                    RowHeight="52">
            <DataGrid.Columns>
              <DataGridTextColumn Header="索引" Binding="{Binding Index}" Width="0.7*" ElementStyle="{StaticResource SettingsDetailTableTextStyle}" />
              <DataGridTextColumn Header="模型标签" Binding="{Binding ModelLabel}" Width="1.5*" ElementStyle="{StaticResource SettingsDetailTableTextStyle}" />
              <DataGridTextColumn Header="产品性状" Binding="{Binding ProductTrait}" Width="1.5*" ElementStyle="{StaticResource SettingsDetailTableTextStyle}" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
