<UserControl x:Class="OceanFresh.SortingSystem.HMI.Pages.ModelImportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
  <Grid Background="{StaticResource SettingsEditorBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="64" />
      <RowDefinition Height="*" />
      <RowDefinition Height="72" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="24,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0"
              VerticalAlignment="Center"
              Margin="0,0,18,0"
              Style="{StaticResource SettingsEditorReturnButtonStyle}"
              Command="{Binding BackToListCommand}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Viewbox Width="16" Height="16" Margin="0,0,8,0">
            <Path Data="{StaticResource SettingsBackIconGeometry}"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.8"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />
          </Viewbox>
          <TextBlock Text="返回列表" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <TextBlock Grid.Column="1"
                 Text="{Binding PageTitle}"
                 Foreground="#EAF4FF"
                 FontSize="26"
                 FontWeight="SemiBold"
                 VerticalAlignment="Center" />
    </Grid>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <Border Width="700"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="0,22,0,24"
              Padding="24"
              Style="{StaticResource SettingsEditorCardStyle}">
        <StackPanel>
          <TextBlock Style="{StaticResource SettingsEditorLabelStyle}" Margin="0,0,0,8">
            <Run Text="海鲜产品" /><Run Text=" *" Foreground="#18B8F2" />
          </TextBlock>
          <ComboBox Height="44"
                    MinHeight="44"
                    Margin="0,0,0,26"
                    Padding="14,0"
                    ItemsSource="{Binding ProductOptions}"
                    SelectedItem="{Binding SelectedProduct}"
                    DisplayMemberPath="Name"
                    Background="{StaticResource SettingsEditorFieldBrush}"
                    BorderBrush="{StaticResource SettingsEditorBorderBrush}"
                    BorderThickness="1" />

          <TextBlock Style="{StaticResource SettingsEditorLabelStyle}" Margin="0,0,0,8">
            <Run Text="YOLO 权重文件" /><Run Text=" *" Foreground="#18B8F2" />
          </TextBlock>
          <Grid Margin="0,0,0,26">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="48" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource SettingsEditorInputFrameStyle}">
              <Grid>
                <TextBox x:Name="WeightFileEditor"
                         Text="{Binding SelectedWeightFilePath, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="True"
                         Foreground="#EAF4FF"
                         FontSize="14"
                         VerticalContentAlignment="Center" />
                <TextBlock Text="请选择模型权重文件"
                           IsHitTestVisible="False"
                           Foreground="#6F879C"
                           FontSize="14"
                           VerticalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=WeightFileEditor}" Value="">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Text, ElementName=WeightFileEditor}" Value="{x:Null}">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
            </Border>
            <Button Grid.Column="2"
                    Style="{StaticResource SettingsEditorIconButtonStyle}"
                    ToolTip="选择权重文件"
                    Command="{Binding BrowseWeightFileCommand}">
              <Path Data="M4,1 L13,1 L18,6 L18,23 L4,23 Z M13,1 L13,6 L18,6"
                    Width="18"
                    Height="20"
                    Stretch="Uniform"
                    Fill="Transparent"
                    Stroke="#6BC9FF"
                    StrokeThickness="1.6"
                    StrokeLineJoin="Round" />
            </Button>
          </Grid>

          <TextBlock Style="{StaticResource SettingsEditorLabelStyle}" Margin="0,0,0,8">
            <Run Text="训练分辨率 imgsz" /><Run Text=" *" Foreground="#18B8F2" />
          </TextBlock>
          <Border Height="44"
                  Margin="0,0,0,26"
                  Style="{StaticResource SettingsEditorInputFrameStyle}">
            <TextBox Text="{Binding DraftTrainingImageSize, UpdateSourceTrigger=PropertyChanged}"
                     Foreground="#EAF4FF"
                     FontSize="14"
                     VerticalContentAlignment="Center"
                     ToolTip="填写该模型训练时使用的 imgsz；推断时由模型版本自动注入。" />
          </Border>

          <TextBlock Style="{StaticResource SettingsEditorLabelStyle}" Margin="0,0,0,8">
            <Run Text="模型描述" /><Run Text=" *" Foreground="#18B8F2" />
          </TextBlock>
          <Border Height="166"
                  Background="{StaticResource SettingsEditorFieldBrush}"
                  BorderBrush="{StaticResource SettingsEditorBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="4"
                  Padding="14,10">
            <Grid>
              <TextBox x:Name="ModelDescriptionEditor"
                       Text="{Binding DraftModelDescription, UpdateSourceTrigger=PropertyChanged}"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       MaxLength="200"
                       Foreground="#EAF4FF"
                       FontSize="14"
                       VerticalScrollBarVisibility="Auto"
                       Padding="0,0,0,24" />
              <TextBlock Text="请输入模型描述"
                         IsHitTestVisible="False"
                         Foreground="#6F879C"
                         FontSize="14"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Text, ElementName=ModelDescriptionEditor}" Value="">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Text, ElementName=ModelDescriptionEditor}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Text="{Binding DescriptionLengthText}"
                         Foreground="#8FA9C1"
                         FontSize="13"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>
    </ScrollViewer>

    <Border Grid.Row="2"
            Background="#061629"
            BorderBrush="{StaticResource SettingsEditorBorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid Margin="24,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   Text="{Binding StatusMessage}"
                   ToolTip="{Binding StatusMessage}"
                   Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibilityConverter}}"
                   Style="{StaticResource SettingsEditorStatusTextStyle}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Button Style="{StaticResource SettingsEditorPrimaryButtonStyle}"
                Command="{Binding SaveImportCommand}">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
            <TextBlock Text="{Binding SaveButtonText}" Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
