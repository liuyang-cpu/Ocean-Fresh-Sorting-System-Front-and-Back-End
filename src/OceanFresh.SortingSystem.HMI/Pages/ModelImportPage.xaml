<UserControl x:Class="OceanFresh.SortingSystem.HMI.Pages.ModelImportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Border Background="{StaticResource PanelBackground}" CornerRadius="18" Padding="24">
      <StackPanel>
        <DockPanel Margin="0,0,0,18">
          <StackPanel>
            <TextBlock Text="导入新模型" Foreground="{StaticResource TextBrush}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="先选海鲜类别和描述，导入成功后再生成版本号。"
                       Foreground="{StaticResource MutedTextBrush}"
                       Margin="0,8,0,0" />
          </StackPanel>
          <Button DockPanel.Dock="Right"
                  Padding="16,10"
                  MinWidth="120"
                  Background="{StaticResource SurfaceBrush}"
                  Foreground="{StaticResource TextBrush}"
                  Command="{Binding BackToListCommand}">
            <TextBlock Text="返回模型列表" />
          </Button>
        </DockPanel>

        <Border Background="{StaticResource SurfaceSoftBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,18">
          <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Margin="0,0,0,16">
          <TextBlock Text="海鲜类别" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
          <Border Background="{StaticResource SurfaceSoftBrush}" CornerRadius="12" Padding="10">
            <ComboBox ItemsSource="{Binding CategoryOptions}"
                      SelectedItem="{Binding SelectedCategory}"
                      DisplayMemberPath="Name"
                      Background="Transparent"
                      BorderThickness="0" />
          </Border>
        </StackPanel>

        <TextBlock Text="模型描述" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
        <Border Background="{StaticResource SurfaceSoftBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,18">
          <TextBox Text="{Binding DraftModelDescription, UpdateSourceTrigger=PropertyChanged}"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   MinHeight="120" />
        </Border>

        <Border Background="{StaticResource SurfaceSoftBrush}"
                CornerRadius="12"
                Padding="14"
                Margin="0,0,0,18"
                Visibility="{Binding HasGeneratedVersionCode, Converter={StaticResource BoolToVisibilityConverter}}">
          <StackPanel>
            <TextBlock Text="本次生成版本号" Foreground="{StaticResource MutedTextBrush}" />
            <TextBlock Text="{Binding DraftVersionCode}" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
          </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal">
          <Button Padding="18,12"
                  Background="{StaticResource AccentBrush}"
                  Foreground="#08121B"
                  FontWeight="Bold"
                  MinWidth="120"
                  Command="{Binding SaveImportCommand}">
            <TextBlock Text="确认导入" />
          </Button>
          <Button Margin="12,0,0,0"
                  Padding="18,12"
                  Background="{StaticResource SurfaceBrush}"
                  Foreground="{StaticResource TextBrush}"
                  MinWidth="108"
                  Command="{Binding BackToListCommand}">
            <TextBlock Text="取消返回" />
          </Button>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
