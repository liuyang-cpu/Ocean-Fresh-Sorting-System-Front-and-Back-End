<UserControl x:Class="OceanFresh.SortingSystem.HMI.Pages.ModelDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI">
  <Grid Background="{StaticResource SettingsEditorBackgroundBrush}" Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="20" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel LastChildFill="False">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource SettingsEditorReturnButtonStyle}" Margin="0,0,18,0" Command="{Binding BackToListCommand}">
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="16" Height="16" Margin="0,0,8,0">
              <Path Data="{StaticResource SettingsBackIconGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Viewbox>
            <TextBlock Text="返回列表" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <TextBlock Text="模型详情" Foreground="#EAF4FF" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource SettingsDetailEditButtonStyle}" Command="{Binding OpenEditCommand}">
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="16" Height="16" Margin="0,0,8,0">
              <Path Data="{StaticResource SettingsEditIconGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeLineJoin="Round" />
            </Viewbox>
            <TextBlock Text="编辑模型" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource SettingsDetailDangerButtonStyle}" Margin="12,0,0,0" Command="{Binding DeleteModelCommand}">
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="16" Height="16" Margin="0,0,8,0">
              <Path Data="{StaticResource SettingsDeleteIconGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeLineJoin="Round" />
            </Viewbox>
            <TextBlock Text="删除模型" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.05*" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="0.95*" />
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource SettingsEditorCardStyle}" Padding="22">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="模型信息" Style="{StaticResource SettingsEditorSectionTitleStyle}" />
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="18" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="18" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="海鲜产品" Foreground="#8FA9C1" FontSize="14" />
              <TextBlock Text="{Binding CategoryName}" Foreground="#EAF4FF" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="版本编号" Foreground="#8FA9C1" FontSize="14" />
              <TextBlock Text="{Binding Version}" Foreground="#4CC3FF" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="4">
              <TextBlock Text="绑定状态" Foreground="#8FA9C1" FontSize="14" />
              <TextBlock Text="{Binding BoundChannelSummary}" Foreground="#25D89B" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0" />
            </StackPanel>
          </Grid>

          <StackPanel Grid.Row="4">
            <TextBlock Text="权重文件" Foreground="#8FA9C1" FontSize="14" Margin="0,0,0,10" />
            <Border Style="{StaticResource SettingsEditorInputFrameStyle}" Height="48">
              <DockPanel>
                <Viewbox DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,12,0">
                  <Path Data="{StaticResource SettingsFileIconGeometry}" Stroke="#79B9DF" StrokeThickness="1.7" StrokeLineJoin="Round" />
                </Viewbox>
                <TextBlock Text="{Binding WeightFilePath}" Foreground="#DCEAF5" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding WeightFilePath}" />
              </DockPanel>
            </Border>
          </StackPanel>

          <StackPanel Grid.Row="6">
            <TextBlock Text="模型描述" Foreground="#8FA9C1" FontSize="14" Margin="0,0,0,10" />
            <Border Background="#09243A" BorderBrush="#24516F" BorderThickness="1" CornerRadius="4" Padding="14" MinHeight="128">
              <TextBlock Text="{Binding Description}" Foreground="#DCEAF5" FontSize="15" TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource SettingsEditorCardStyle}" Padding="22">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel LastChildFill="False">
            <TextBlock Text="绑定通道" Style="{StaticResource SettingsEditorSectionTitleStyle}" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding BoundChannelSummary}" Foreground="#8FA9C1" FontSize="14" VerticalAlignment="Center" />
          </DockPanel>
          <DataGrid Grid.Row="2"
                    ItemsSource="{Binding BoundChannels}"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserResizeColumns="False"
                    IsReadOnly="True"
                    Style="{StaticResource SettingsListDataGridStyle}"
                    ColumnHeaderStyle="{StaticResource SettingsDetailTableHeaderStyle}"
                    RowHeight="52">
            <DataGrid.Columns>
              <DataGridTextColumn Header="通道名称" Binding="{Binding ChannelName}" Width="2*" ElementStyle="{StaticResource SettingsDetailTableTextStyle}" />
              <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="*" ElementStyle="{StaticResource SettingsDetailTableTextStyle}" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
