<UserControl x:Class="OceanFresh.SortingSystem.HMI.Pages.ModelManagementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Border Background="{StaticResource PanelBackground}" CornerRadius="18" Padding="24">
      <StackPanel>
        <DockPanel Margin="0,0,0,18">
          <StackPanel>
            <TextBlock Text="模型列表" Foreground="{StaticResource TextBrush}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="先按海鲜类别筛选，再查看绑定状态和版本号。"
                       Foreground="{StaticResource MutedTextBrush}"
                       Margin="0,8,0,0" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
            <StackPanel Width="220" Margin="0,0,12,0">
              <TextBlock Text="海鲜类别筛选" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
              <Border Background="{StaticResource SurfaceSoftBrush}" CornerRadius="12" Padding="10">
                <ComboBox ItemsSource="{Binding CategoryOptions}"
                          SelectedItem="{Binding SelectedCategory}"
                          DisplayMemberPath="Name"
                          Background="Transparent"
                          BorderThickness="0" />
              </Border>
            </StackPanel>
            <Button Padding="16,10"
                    Background="{StaticResource AccentBrush}"
                    Foreground="#08121B"
                    FontWeight="Bold"
                    MinWidth="120"
                    Command="{Binding OpenImportPageCommand}">
              <TextBlock Text="导入新模型" />
            </Button>
          </StackPanel>
        </DockPanel>

        <Border Background="{StaticResource SurfaceSoftBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,18">
          <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
        </Border>

        <DataGrid ItemsSource="{Binding Models}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionUnit="FullRow"
                  MinHeight="520">
          <DataGrid.Columns>
            <DataGridTextColumn Header="海鲜类别" Binding="{Binding CategoryName}" Width="*" />
            <DataGridTextColumn Header="版本编号" Binding="{Binding Version}" Width="1.2*" />
            <DataGridTextColumn Header="绑定状态" Binding="{Binding Status}" Width="*" />
            <DataGridCheckBoxColumn Header="已绑定通道" Binding="{Binding IsBound}" Width="0.8*" />
            <DataGridTextColumn Header="标签映射" Binding="{Binding LabelMap}" Width="2*" />
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
