<UserControl x:Class="OceanFresh.SortingSystem.HMI.Pages.ModelManagementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextHintingMode="Fixed">
  <Border Background="#0B2136"
          BorderBrush="#31465A"
          BorderThickness="1"
          CornerRadius="5"
          Padding="24">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="44" />
        <RowDefinition Height="*" />
        <RowDefinition Height="72" />
      </Grid.RowDefinitions>

      <DockPanel Margin="0,0,0,18" LastChildFill="False">
        <StackPanel>
          <TextBlock Text="模型管理" Foreground="#EAF4FF" FontSize="26" FontWeight="SemiBold" />
        </StackPanel>
        <Button DockPanel.Dock="Right"
                Style="{StaticResource SettingsListAddButtonStyle}"
                Command="{Binding OpenImportPageCommand}">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="＋" FontSize="18" FontWeight="Normal" VerticalAlignment="Center" />
            <TextBlock Text="添加模型" Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </DockPanel>

      <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="440"
                Margin="0,0,24,0"
                Style="{StaticResource SettingsListSearchContainerStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="22" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE721;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="15"
                       Foreground="#73A7C7"
                       VerticalAlignment="Center" />
            <TextBox Grid.Column="1"
                     Style="{StaticResource SettingsListSearchTextBoxStyle}"
                     Text="{Binding ModelSearchText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="搜索版本编号、权重文件或绑定通道" />
          </Grid>
        </Border>
        <TextBlock Text="海鲜类别" Style="{StaticResource SettingsListFilterLabelStyle}" />
        <ComboBox Width="238"
                  Style="{StaticResource SettingsListFilterComboBoxStyle}"
                  ItemsSource="{Binding CategoryOptions}"
                  SelectedItem="{Binding SelectedCategory}"
                  DisplayMemberPath="Name" />
      </StackPanel>

      <DataGrid Grid.Row="2"
                Margin="0,14,0,14"
                Style="{StaticResource SettingsListDataGridStyle}"
                ItemsSource="{Binding VisibleModels}"
                SelectedItem="{Binding SelectedModel}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                IsReadOnly="True"
                SelectionUnit="FullRow"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
        <DataGrid.Columns>
          <DataGridTextColumn Header="海鲜类别"
                              Binding="{Binding CategoryName}"
                              Width="1*"
                              ElementStyle="{StaticResource SettingsListTextCellStyle}" />
          <DataGridTextColumn Header="版本编号"
                              Binding="{Binding Version}"
                              Width="1*"
                              ElementStyle="{StaticResource SettingsListTextCellStyle}" />
          <DataGridTemplateColumn Header="绑定状态" Width="1.4*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel x:Name="BindingStateContent"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0"
                            ToolTip="{Binding BoundChannelNames}">
                  <Ellipse x:Name="BindingStateDot"
                           Width="8"
                           Height="8"
                           Fill="#18B8F2"
                           Margin="0,0,10,0" />
                  <TextBlock x:Name="BindingStateText"
                             Text="{Binding BindingStatusText}"
                             Foreground="#DCEAF5"
                             FontSize="15"
                             VerticalAlignment="Center" />
                  <TextBlock x:Name="BindingCountText"
                             Text="{Binding BoundChannelCountText}"
                             Foreground="#8FA9C1"
                             FontSize="14"
                             Margin="14,0,0,0"
                             VerticalAlignment="Center" />
                </StackPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding BoundChannelCount}" Value="0">
                    <Setter TargetName="BindingStateDot" Property="Fill" Value="#5E748A" />
                    <Setter TargetName="BindingStateText" Property="Foreground" Value="#8FA9C1" />
                    <Setter TargetName="BindingCountText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="BindingStateContent" Property="ToolTip" Value="{x:Null}" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="操作" Width="180">
            <DataGridTemplateColumn.HeaderStyle>
              <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource SettingsListColumnHeaderStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
              </Style>
            </DataGridTemplateColumn.HeaderStyle>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Button Style="{StaticResource SettingsListActionButtonStyle}"
                          Tag="{StaticResource SettingsPreviewIconGeometry}"
                          Command="{Binding DataContext.OpenModelDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}"
                          ToolTip="预览模型" />
                  <Button Style="{StaticResource SettingsListActionButtonStyle}"
                          Tag="{StaticResource SettingsEditIconGeometry}"
                          Margin="12,0,0,0"
                          Command="{Binding DataContext.OpenEditModelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}"
                          ToolTip="编辑模型" />
                  <Button Style="{StaticResource SettingsListDangerButtonStyle}"
                          Tag="{StaticResource SettingsDeleteIconGeometry}"
                          Margin="12,0,0,0"
                          Command="{Binding DataContext.DeleteModelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}"
                          ToolTip="删除模型" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <Grid Grid.Row="3">
        <TextBlock Text="{Binding Models.Count, StringFormat=共 {0} 条}"
                   Foreground="#EAF4FF"
                   FontSize="15"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
          <Button Style="{StaticResource UnifiedPagerButtonStyle}"
                  Command="{Binding PreviousPageCommand}"
                  IsEnabled="{Binding CanGoToPreviousPage}"
                  Content="‹" />
          <TextBlock Text="{Binding PageSummary}" Width="64" Margin="8,0"
                     Foreground="#DCEAF5" FontSize="14" TextAlignment="Center" VerticalAlignment="Center" />
          <Button Style="{StaticResource UnifiedPagerButtonStyle}"
                  Command="{Binding NextPageCommand}"
                  IsEnabled="{Binding CanGoToNextPage}"
                  Content="›" />
          <TextBlock Text="每页" Margin="20,0,8,0" Foreground="#8FA9C1" FontSize="13" VerticalAlignment="Center" />
          <ComboBox Width="78" Height="34" MinHeight="34" Padding="8,4"
                    ItemsSource="{Binding PageSizeOptions}" DisplayMemberPath="Value"
                    SelectedValuePath="Value" SelectedValue="{Binding SelectedPageSize}"
                    Background="#0D2942" BorderBrush="#31465A" BorderThickness="1" />
          <TextBlock Text="条" Margin="8,0,0,0" Foreground="#8FA9C1" FontSize="13" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>
