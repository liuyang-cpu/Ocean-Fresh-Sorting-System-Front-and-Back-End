<UserControl x:Class="OceanFresh.SortingSystem.HMI.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Noto Sans SC, Microsoft YaHei UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
  <Grid Background="{StaticResource ShellBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="74" />
      <RowDefinition Height="58" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="#1B2A3B"
            Padding="24,0"
            BorderBrush="#3A4B5C"
            BorderThickness="0,0,0,1">
      <ItemsControl ItemsSource="{Binding TopTabs}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Margin="0,0,34,0"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding DataContext.SelectTopTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
              <Grid Width="116" Height="74">
                <Border x:Name="TabIndicator"
                        Height="4"
                        VerticalAlignment="Bottom"
                        Background="#4CC3FF"
                        Visibility="Collapsed" />
                <TextBlock x:Name="TabText"
                           Text="{Binding Title}"
                           Foreground="#98A9BA"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
              </Grid>
            </Button>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="TabIndicator" Property="Visibility" Value="Visible" />
                <Setter TargetName="TabText" Property="Foreground" Value="White" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <Border Grid.Row="1"
            Background="#0A1221"
            Padding="12,0"
            BorderBrush="#1D2B3A"
            BorderThickness="0,0,0,1">
      <ItemsControl ItemsSource="{Binding ModuleShortcuts}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Margin="0,0,36,0"
                    Padding="0"
                    MinWidth="112"
                    Height="58"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding DataContext.SelectModuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
              <Grid Height="58">
                <Border x:Name="ModuleIndicator"
                        Height="3"
                        VerticalAlignment="Bottom"
                        Background="#4CC3FF"
                        Visibility="Collapsed" />
                <TextBlock x:Name="ModuleText"
                           Text="{Binding Title}"
                           Foreground="#8293A6"
                           FontSize="17"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
              </Grid>
            </Button>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="ModuleIndicator" Property="Visibility" Value="Visible" />
                <Setter TargetName="ModuleText" Property="Foreground" Value="#4CC3FF" />
                <Setter TargetName="ModuleText" Property="FontWeight" Value="Bold" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <Border Grid.Row="2"
            Background="{StaticResource ShellBackground}"
            Padding="12"
            BorderThickness="0">
      <Border Background="{StaticResource ShellBackground}"
              CornerRadius="4"
              Padding="0"
              BorderThickness="0"
              ClipToBounds="True">
        <ContentControl Content="{Binding CurrentModulePage}" />
      </Border>
    </Border>
  </Grid>
</UserControl>
