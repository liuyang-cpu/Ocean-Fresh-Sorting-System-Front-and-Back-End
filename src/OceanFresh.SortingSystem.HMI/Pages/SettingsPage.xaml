<UserControl x:Class="OceanFresh.SortingSystem.HMI.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Background="#122C52" CornerRadius="16" Padding="20">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Margin="0,0,12,0">
        <TextBlock Text="系统策略" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" />
        <TextBlock Text="角色: 操作员 / 管理员" Foreground="#CFE2FF" Margin="0,0,0,10" />
        <TextBlock Text="告警阈值: 推理超时 / 掉线 / 急停 / X 光异常" Foreground="#CFE2FF" Margin="0,0,0,10" />
        <TextBlock Text="日志保留: 检测记录索引、操作日志、告警日志" Foreground="#CFE2FF" />
      </StackPanel>

      <StackPanel Grid.Column="1">
        <TextBlock Text="后续接入项" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" />
        <TextBlock Text="SQLite 持久化" Foreground="#CFE2FF" Margin="0,0,0,10" />
        <TextBlock Text="ONNX Runtime CUDA 推理" Foreground="#CFE2FF" Margin="0,0,0,10" />
        <TextBlock Text="MES 数据同步接口" Foreground="#CFE2FF" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
