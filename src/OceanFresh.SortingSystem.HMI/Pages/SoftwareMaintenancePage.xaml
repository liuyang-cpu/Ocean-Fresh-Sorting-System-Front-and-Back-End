<UserControl x:Class="OceanFresh.SortingSystem.HMI.Pages.SoftwareMaintenancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
  <UserControl.Resources>
    <Style x:Key="MaintenanceGridStyle" TargetType="DataGrid" BasedOn="{StaticResource SettingsListDataGridStyle}">
      <Setter Property="RowHeight" Value="52" />
      <Setter Property="ColumnHeaderHeight" Value="44" />
      <Setter Property="Background" Value="#071B2D" />
      <Setter Property="RowBackground" Value="#081E31" />
      <Setter Property="AlternatingRowBackground" Value="#0A263C" />
      <Setter Property="HorizontalGridLinesBrush" Value="#28475D" />
    </Style>
    <Style x:Key="VerticallyCenteredHistoryText" TargetType="TextBlock" BasedOn="{StaticResource SettingsListTextCellStyle}">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Left" />
      <Setter Property="Margin" Value="16,0" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </UserControl.Resources>

  <Grid Background="{StaticResource ShellBackground}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="0.82*" />
      <ColumnDefinition Width="14" />
      <ColumnDefinition Width="1.78*" />
    </Grid.ColumnDefinitions>

    <Border Background="#071B2D" BorderBrush="#315873" BorderThickness="1" CornerRadius="4">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="56" />
          <RowDefinition Height="*" />
          <RowDefinition Height="58" />
        </Grid.RowDefinitions>
        <Border BorderBrush="#315873" BorderThickness="0,0,0,1" Padding="18,0">
          <TextBlock Text="软件版本" Foreground="#DCEAF5" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Row="1" Margin="18,18">
          <TextBlock Text="{Binding ProductName}" Foreground="#C8D8E5" FontSize="15" />
          <TextBlock Text="{Binding CurrentVersion}" Foreground="#4CA8DE" FontSize="27" FontWeight="SemiBold" Margin="0,10,0,18" />
          <Border BorderBrush="#28475D" BorderThickness="0,1,0,0" Padding="0,14,0,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="118" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="48" /><RowDefinition Height="48" /><RowDefinition Height="48" /><RowDefinition Height="48" />
              </Grid.RowDefinitions>
              <TextBlock Text="构建时间" Foreground="#8FA9C1" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding BuildTime}" Foreground="#C8D8E5" VerticalAlignment="Center" TextWrapping="Wrap" />
              <TextBlock Grid.Row="1" Text="数据库版本" Foreground="#8FA9C1" VerticalAlignment="Center" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DatabaseVersion}" Foreground="#C8D8E5" VerticalAlignment="Center" />
              <TextBlock Grid.Row="2" Text="YOLO 服务" Foreground="#8FA9C1" VerticalAlignment="Center" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding YoloServiceVersion}" Foreground="#C8D8E5" VerticalAlignment="Center" />
              <TextBlock Grid.Row="3" Text="运行环境" Foreground="#8FA9C1" VerticalAlignment="Center" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RuntimeEnvironment}" Foreground="#C8D8E5" VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
          </Border>
        </StackPanel>
        <Border Grid.Row="2" Margin="18,0,18,16" BorderBrush="#8B6A27" BorderThickness="1" CornerRadius="3" Background="#182536">
          <TextBlock Text="机器运行中禁止更新" Foreground="#D39A2C" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="0.88*" />
        <RowDefinition Height="14" />
        <RowDefinition Height="1.12*" />
      </Grid.RowDefinitions>

      <Border Background="#071B2D" BorderBrush="#315873" BorderThickness="1" CornerRadius="4">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border BorderBrush="#315873" BorderThickness="0,0,0,1" Padding="18,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="网络更新" Foreground="#DCEAF5" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
                <Ellipse Width="8" Height="8" Fill="#20C982" Margin="0,0,8,0" />
                <TextBlock Foreground="#20C982" VerticalAlignment="Center">
                  <Run Text="{Binding NetworkStatus}" /><Run Text=" · " /><Run Text="{Binding NetworkAdapter}" />
                </TextBlock>
              </StackPanel>
            </Grid>
          </Border>

          <Grid Grid.Row="1" Margin="18,14,18,16">
            <Grid.RowDefinitions>
              <RowDefinition Height="52" />
              <RowDefinition Height="48" />
              <RowDefinition Height="*" />
              <RowDefinition Height="56" />
            </Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="28" /><ColumnDefinition Width="110" /><ColumnDefinition Width="1*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="当前版本" Foreground="#8FA9C1" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding CurrentVersion}" Foreground="#DCEAF5" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Border Grid.Column="2" Background="#28475D" Margin="0,7" />
              <TextBlock Grid.Column="4" Text="最新版本" Foreground="#8FA9C1" VerticalAlignment="Center" />
              <TextBlock Grid.Column="5" Text="{Binding LatestVersion}" Foreground="#DCEAF5" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
            <Border Grid.Row="1" BorderBrush="#28475D" BorderThickness="0,1,0,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ReleaseDate, StringFormat=发布日期 {0}}" Foreground="#8FA9C1" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding PackageSize, StringFormat=大小 {0}}" Foreground="#8FA9C1" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding ReleaseNotes}" Foreground="#AFC2D2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </Grid>
            </Border>
            <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="#8FA9C1" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Grid Grid.Row="3">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="112" /><ColumnDefinition Width="10" /><ColumnDefinition Width="142" /></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Fill="#D39A2C" Margin="0,0,9,0" />
                <TextBlock Text="{Binding UpdateBlockedText}" Foreground="#D39A2C" VerticalAlignment="Center" />
              </StackPanel>
              <Button Grid.Column="1" Height="40" Background="#071B2D" BorderBrush="#315873" BorderThickness="1" Command="{Binding CheckForUpdatesCommand}" Content="检查更新" />
              <Button Grid.Column="3" Height="40" Background="#1A2B3C" BorderBrush="#315873" BorderThickness="1" Command="{Binding StartUpdateCommand}" IsEnabled="{Binding CanStartUpdate}" Content="{Binding UpdateButtonText}" />
            </Grid>
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Row="2" Background="#071B2D" BorderBrush="#315873" BorderThickness="1" CornerRadius="4">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="54" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Border BorderBrush="#315873" BorderThickness="0,0,0,1" Padding="18,0">
            <TextBlock Text="更新历史" Foreground="#DCEAF5" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
          </Border>
          <DataGrid Grid.Row="1" ItemsSource="{Binding RecentUpdates}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                    Style="{StaticResource MaintenanceGridStyle}"
                    ColumnHeaderStyle="{StaticResource SettingsListColumnHeaderStyle}"
                    CellStyle="{StaticResource SettingsListCellStyle}"
                    RowStyle="{StaticResource SettingsListRowStyle}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="1*" ElementStyle="{StaticResource VerticallyCenteredHistoryText}" />
              <DataGridTextColumn Header="更新时间" Binding="{Binding InstalledAt}" Width="1.35*" ElementStyle="{StaticResource VerticallyCenteredHistoryText}" />
              <DataGridTextColumn Header="更新方式" Binding="{Binding UpdateMethod}" Width="1.15*" ElementStyle="{StaticResource VerticallyCenteredHistoryText}" />
              <DataGridTextColumn Header="状态" Binding="{Binding Result}" Width="0.85*" ElementStyle="{StaticResource VerticallyCenteredHistoryText}" />
              <DataGridTextColumn Header="操作人" Binding="{Binding Operator}" Width="1*" ElementStyle="{StaticResource VerticallyCenteredHistoryText}" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
