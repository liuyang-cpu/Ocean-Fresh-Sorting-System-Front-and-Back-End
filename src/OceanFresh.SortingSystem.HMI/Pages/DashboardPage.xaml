<UserControl x:Class="OceanFresh.SortingSystem.HMI.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <UniformGrid Columns="4" Margin="0,0,0,16">
      <Border Background="#14335C" CornerRadius="16" Margin="0,0,12,0" Padding="18">
        <StackPanel>
          <TextBlock Text="班次检测数" Foreground="#9FC8FF" />
          <TextBlock Text="{Binding TotalCount}" Foreground="White" FontSize="30" FontWeight="Bold" />
        </StackPanel>
      </Border>
      <Border Background="#14335C" CornerRadius="16" Margin="0,0,12,0" Padding="18">
        <StackPanel>
          <TextBlock Text="异常剔除数" Foreground="#9FC8FF" />
          <TextBlock Text="{Binding RejectCount}" Foreground="White" FontSize="30" FontWeight="Bold" />
        </StackPanel>
      </Border>
      <Border Background="#14335C" CornerRadius="16" Margin="0,0,12,0" Padding="18">
        <StackPanel>
          <TextBlock Text="当前模型" Foreground="#9FC8FF" />
          <TextBlock Text="{Binding ModelVersion}" Foreground="White" FontSize="24" FontWeight="Bold" />
        </StackPanel>
      </Border>
      <Border Background="#20D58C" CornerRadius="16" Padding="18">
        <StackPanel>
          <TextBlock Text="良率" Foreground="#08321E" />
          <TextBlock Text="{Binding YieldRate}" Foreground="#04131F" FontSize="30" FontWeight="Bold" />
        </StackPanel>
      </Border>
    </UniformGrid>

    <Grid Grid.Row="1" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Background="#122C52" CornerRadius="16" Padding="20" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="设备状态" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />
          <ItemsControl ItemsSource="{Binding DeviceSummaries}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="#17335D" CornerRadius="12" Margin="0,0,0,10" Padding="14">
                  <DockPanel>
                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Status}" Foreground="#20D58C" DockPanel.Dock="Right" />
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Background="#122C52" CornerRadius="16" Padding="20">
        <StackPanel>
          <TextBlock Text="当前告警策略" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />
          <TextBlock Text="推理超时 -> 告警停机" Foreground="#CFE2FF" Margin="0,0,0,10" />
          <TextBlock Text="设备掉线 -> 受限运行/停机" Foreground="#CFE2FF" Margin="0,0,0,10" />
          <TextBlock Text="低置信目标 -> 按配方剔除或停机" Foreground="#CFE2FF" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#122C52" CornerRadius="16" Padding="20">
      <StackPanel>
        <TextBlock Text="V1 落地重点" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />
        <TextBlock Text="1. 按海鲜类别绑定模型，支持多版本启用与回滚" Foreground="#CFE2FF" Margin="0,0,0,8" />
        <TextBlock Text="2. 实时链路独立于 HMI，避免界面卡顿影响剔除控制" Foreground="#CFE2FF" Margin="0,0,0,8" />
        <TextBlock Text="3. 产品配方同时承载工艺参数与模型切换策略" Foreground="#CFE2FF" Margin="0,0,0,8" />
        <TextBlock Text="4. 为 MES 保留同步接口，但本地单机可独立运行" Foreground="#CFE2FF" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
