<UserControl x:Class="OceanFresh.SortingSystem.HMI.Pages.DeviceManagementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
  <UserControl.Resources>
    <Style x:Key="CompactFieldStyle" TargetType="TextBox">
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="#081D31" />
      <Setter Property="Foreground" Value="#DCEAF5" />
      <Setter Property="BorderBrush" Value="#315873" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="DeviceGridStyle" TargetType="DataGrid" BasedOn="{StaticResource SettingsListDataGridStyle}">
      <Setter Property="RowHeight" Value="56" />
      <Setter Property="ColumnHeaderHeight" Value="48" />
      <Setter Property="Background" Value="#071B2D" />
      <Setter Property="RowBackground" Value="#081E31" />
      <Setter Property="AlternatingRowBackground" Value="#0A263C" />
      <Setter Property="HorizontalGridLinesBrush" Value="#315873" />
      <Setter Property="SelectionUnit" Value="FullRow" />
    </Style>
    <Style x:Key="VerticallyCenteredCellText" TargetType="TextBlock" BasedOn="{StaticResource SettingsListTextCellStyle}">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Left" />
      <Setter Property="Margin" Value="16,0" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </UserControl.Resources>

  <Grid Background="{StaticResource ShellBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="58" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
      <Button Width="92" Height="40" Margin="0,0,10,0"
              Background="#071B2D" BorderBrush="#315873" BorderThickness="1"
              Command="{Binding RefreshCommand}" Content="刷新" />
      <Button Width="112" Height="40"
              Background="#3C82AD" BorderBrush="#5F9DC4" BorderThickness="1"
              Command="{Binding NewDeviceCommand}" Content="新增设备" />
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.7*" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="0.9*" />
      </Grid.ColumnDefinitions>

      <Border Background="#071B2D" BorderBrush="#315873" BorderThickness="1" CornerRadius="4">
        <DataGrid ItemsSource="{Binding Devices}"
                  SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  Style="{StaticResource DeviceGridStyle}"
                  ColumnHeaderStyle="{StaticResource SettingsListColumnHeaderStyle}"
                  CellStyle="{StaticResource SettingsListCellStyle}"
                  RowStyle="{StaticResource SettingsListRowStyle}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="设备编号" Binding="{Binding DeviceNo}" Width="1.15*" ElementStyle="{StaticResource VerticallyCenteredCellText}" />
            <DataGridTextColumn Header="设备名称" Binding="{Binding Name}" Width="1.2*" ElementStyle="{StaticResource VerticallyCenteredCellText}" />
            <DataGridTextColumn Header="类型" Binding="{Binding TypeText}" Width="1.05*" ElementStyle="{StaticResource VerticallyCenteredCellText}" />
            <DataGridTextColumn Header="固件版本" Binding="{Binding FirmwareVersion}" Width="1*" ElementStyle="{StaticResource VerticallyCenteredCellText}" />
            <DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="0.8*" ElementStyle="{StaticResource VerticallyCenteredCellText}" />
            <DataGridTextColumn Header="自检结果" Binding="{Binding LastSelfCheckText}" Width="1.35*" ElementStyle="{StaticResource VerticallyCenteredCellText}" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <Border Grid.Column="2" Background="#071B2D" BorderBrush="#315873" BorderThickness="1" CornerRadius="4">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="72" />
          </Grid.RowDefinitions>

          <Border BorderBrush="#315873" BorderThickness="0,0,0,1" Padding="20,0">
            <TextBlock Text="设备编辑与自检" Foreground="#DCEAF5" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
          </Border>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="118" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="58" />
                <RowDefinition Height="58" />
                <RowDefinition Height="58" />
                <RowDefinition Height="58" />
                <RowDefinition Height="58" />
                <RowDefinition Height="106" />
              </Grid.RowDefinitions>

              <TextBlock Text="设备编号" Foreground="#9BB0C2" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding DeviceNo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CompactFieldStyle}" />
              <TextBlock Grid.Row="1" Text="设备名称" Foreground="#9BB0C2" VerticalAlignment="Center" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CompactFieldStyle}" />
              <TextBlock Grid.Row="2" Text="设备类型" Foreground="#9BB0C2" VerticalAlignment="Center" />
              <ComboBox Grid.Row="2" Grid.Column="1" Height="44" ItemsSource="{Binding DeviceTypeOptions}" SelectedItem="{Binding SelectedDeviceType, Mode=TwoWay}" />
              <TextBlock Grid.Row="3" Text="固件版本" Foreground="#9BB0C2" VerticalAlignment="Center" />
              <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding FirmwareVersion, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CompactFieldStyle}" />
              <TextBlock Grid.Row="4" Text="当前状态" Foreground="#9BB0C2" VerticalAlignment="Center" />
              <ComboBox Grid.Row="4" Grid.Column="1" Height="44" ItemsSource="{Binding DeviceStateOptions}" SelectedItem="{Binding SelectedState, Mode=TwoWay}" />
              <TextBlock Grid.Row="5" Text="启用设备" Foreground="#9BB0C2" VerticalAlignment="Center" />
              <CheckBox Grid.Row="5" Grid.Column="1" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" />
              <TextBlock Grid.Row="6" Text="备注" Foreground="#9BB0C2" VerticalAlignment="Top" Margin="0,12,0,0" />
              <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                       AcceptsReturn="True" TextWrapping="Wrap" Padding="12,10"
                       Background="#081D31" Foreground="#DCEAF5" BorderBrush="#315873" BorderThickness="1" />
            </Grid>
          </ScrollViewer>

          <StackPanel Grid.Row="2" Margin="20,12" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="104" Height="40" Margin="0,0,10,0" Background="#3C82AD" BorderBrush="#5F9DC4" BorderThickness="1" Command="{Binding SaveDeviceCommand}" Content="保存设备" />
            <Button Width="104" Height="40" Margin="0,0,10,0" Background="#071B2D" BorderBrush="#315873" BorderThickness="1" Command="{Binding RunSelfCheckCommand}" Content="执行自检" />
            <Button Width="82" Height="40" Background="#071B2D" BorderBrush="#C33E4E" BorderThickness="1" Foreground="#F05A68" Command="{Binding DeleteDeviceCommand}" Content="删除" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
