<UserControl x:Class="OceanFresh.SortingSystem.HMI.Pages.SafetyAlarmsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
  <UserControl.Resources>
    <Style x:Key="AlarmGridStyle" TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="CanUserDeleteRows" Value="False" />
      <Setter Property="CanUserResizeColumns" Value="False" />
      <Setter Property="CanUserResizeRows" Value="False" />
      <Setter Property="CanUserReorderColumns" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="#28475D" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="#071B2D" />
      <Setter Property="RowBackground" Value="#081E31" />
      <Setter Property="AlternatingRowBackground" Value="#0A263C" />
      <Setter Property="RowHeight" Value="58" />
      <Setter Property="ColumnHeaderHeight" Value="44" />
      <Setter Property="SelectionUnit" Value="FullRow" />
      <Setter Property="SelectionMode" Value="Single" />
      <Setter Property="Foreground" Value="#DCEAF5" />
    </Style>
    <Style x:Key="AlarmHeaderStyle" TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#163D57" />
      <Setter Property="Foreground" Value="#DCEAF5" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="AlarmCellStyle" TargetType="DataGridCell">
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#C8D8E5" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Background" Value="Transparent" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#174565" />
          <Setter Property="Foreground" Value="#FFFFFF" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="VerticallyCenteredAlarmText" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Left" />
      <Setter Property="Margin" Value="14,0" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </UserControl.Resources>

  <Grid Background="{StaticResource ShellBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="58" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
      <Button Width="88" Height="40" Margin="0,0,10,0"
              Background="#071B2D" BorderBrush="#315873" BorderThickness="1"
              Command="{Binding RefreshCommand}" Content="刷新" />
      <Button Width="126" Height="40"
              Background="#3C82AD" BorderBrush="#5F9DC4" BorderThickness="1"
              Command="{Binding AcknowledgeCommand}" Content="确认选中预警" />
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.75*" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="0.95*" />
      </Grid.ColumnDefinitions>

      <Border Background="#071B2D" BorderBrush="#315873" BorderThickness="1" CornerRadius="4">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border BorderBrush="#315873" BorderThickness="0,0,0,1" Padding="18,0">
            <DockPanel LastChildFill="False">
              <TextBlock Text="未确认预警" Foreground="#DCEAF5" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBlock DockPanel.Dock="Right" Text="{Binding ActiveAlarms.Count, StringFormat={}{0} 条}" Foreground="#8FA9C1" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <DataGrid Grid.Row="1"
                    ItemsSource="{Binding ActiveAlarms}"
                    SelectedItem="{Binding SelectedAlarm, Mode=TwoWay}"
                    Style="{StaticResource AlarmGridStyle}"
                    ColumnHeaderStyle="{StaticResource AlarmHeaderStyle}"
                    CellStyle="{StaticResource AlarmCellStyle}">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="等级" Width="0.75*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                      <Ellipse Width="8" Height="8" Fill="{Binding SeverityColor}" Margin="0,0,9,0" />
                      <TextBlock Text="{Binding Severity}" VerticalAlignment="Center" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="1.05*" ElementStyle="{StaticResource VerticallyCenteredAlarmText}" />
              <DataGridTextColumn Header="编码" Binding="{Binding Code}" Width="1.05*" ElementStyle="{StaticResource VerticallyCenteredAlarmText}" />
              <DataGridTextColumn Header="内容" Binding="{Binding Message}" Width="1.7*" ElementStyle="{StaticResource VerticallyCenteredAlarmText}" />
              <DataGridTextColumn Header="时间" Binding="{Binding RaisedAt}" Width="1.35*" ElementStyle="{StaticResource VerticallyCenteredAlarmText}" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="0.78*" />
          <RowDefinition Height="14" />
          <RowDefinition Height="1.22*" />
        </Grid.RowDefinitions>

        <Border Background="#071B2D" BorderBrush="#315873" BorderThickness="1" CornerRadius="4">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="54" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border BorderBrush="#315873" BorderThickness="0,0,0,1" Padding="18,0">
              <TextBlock Text="硬件联锁" Foreground="#DCEAF5" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Row="1" Margin="18,16">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" Fill="{Binding InterlockColor}" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding InterlockTitle}" Foreground="{Binding InterlockColor}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{Binding InterlockSummary}" Foreground="#8FA9C1" Margin="0,14,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Row="2" Background="#071B2D" BorderBrush="#315873" BorderThickness="1" CornerRadius="4">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="54" />
              <RowDefinition Height="44" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border BorderBrush="#315873" BorderThickness="0,0,0,1" Padding="18,0">
              <TextBlock Text="关键硬件状态" Foreground="#DCEAF5" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Border>
            <Grid Grid.Row="1" Background="#163D57">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="0.75*" />
                <ColumnDefinition Width="1.4*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="设备" Margin="14,0" Foreground="#DCEAF5" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="状态" Margin="14,0" Foreground="#DCEAF5" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="信息" Margin="14,0" Foreground="#DCEAF5" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
            <ItemsControl Grid.Row="2" ItemsSource="{Binding InterlockDevices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Height="52" Background="#081E31" BorderBrush="#28475D" BorderThickness="0,0,0,1">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="0.75*" />
                        <ColumnDefinition Width="1.4*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding DeviceKey}" Margin="14,0" Foreground="#C8D8E5" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{Binding Color}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding State}" Foreground="{Binding Color}" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding Message}" Margin="14,0" Foreground="#8FA9C1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
