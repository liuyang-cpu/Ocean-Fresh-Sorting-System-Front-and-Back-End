<UserControl x:Class="OceanFresh.SortingSystem.HMI.Pages.MonitoringPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="MonitorPanelStyle" TargetType="Border">
      <Setter Property="Background" Value="#071D31" />
      <Setter Property="BorderBrush" Value="#164869" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style x:Key="MonitorLabelTextStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#8FA8C2" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="MonitorTitleTextStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#E8F2FF" />
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="ChannelDialogListItemStyle" TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#244B68" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid>
              <Border x:Name="SelectionAccent"
                      Width="4"
                      HorizontalAlignment="Left"
                      Background="Transparent" />
              <Border x:Name="ItemBorder"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="3"
                      Padding="18,0">
                <ContentPresenter HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center" />
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#16A8FF" />
                <Setter TargetName="ItemBorder" Property="Background" Value="#0A304F" />
                <Setter TargetName="SelectionAccent" Property="Background" Value="#16A8FF" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#0A243A" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="YieldDistributionBarStyle" TargetType="ProgressBar">
      <Setter Property="Height" Value="8" />
      <Setter Property="Foreground" Value="#4CA6FF" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid SnapsToDevicePixels="True">
              <Border x:Name="PART_Track"
                      Background="{TemplateBinding Background}"
                      CornerRadius="4" />
              <Border x:Name="PART_Indicator"
                      HorizontalAlignment="Left"
                      Background="{TemplateBinding Foreground}"
                      CornerRadius="4" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Background="#061522">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" MinHeight="370" />
      <RowDefinition Height="10" />
      <RowDefinition Height="82" />
      <RowDefinition Height="8" />
      <RowDefinition Height="367" />
      <RowDefinition Height="0" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource MonitorPanelStyle}" Padding="10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="44" />
          <RowDefinition Height="8" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel LastChildFill="True" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
            <TextBlock Text="食品检测"
                       Foreground="#E8F2FF"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,28,0" />
            <TextBlock Text="当前通道"
                       Foreground="#8FA8C2"
                       FontSize="13"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding CurrentChannelValue}"
                       Foreground="#E8F2FF"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,18,0"
                       VerticalAlignment="Center" />
            <Border Width="1" Height="24" Background="#244B68" Margin="0,0,18,0" />
            <TextBlock Text="{Binding CurrentProductValue}"
                       Foreground="#B8CAE0"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center" />
            <TextBlock Text="·" Foreground="#617B94" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding CurrentModelValue}"
                       Foreground="#B8CAE0"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,20,0"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasActiveChannel, Converter={StaticResource BoolToVisibilityConverter}}">
              <Ellipse Width="8" Height="8" Fill="#20D98B" Margin="0,0,7,0" />
              <TextBlock Text="当前使用" Foreground="#20D98B" FontSize="13" FontWeight="SemiBold" />
            </StackPanel>
            <Button Width="108"
                    Height="32"
                    Margin="18,0,0,0"
                    Padding="10,0"
                    Background="#081F34"
                    BorderBrush="#315B78"
                    BorderThickness="1"
                    Foreground="#CFE2F2"
                    IsEnabled="{Binding CanOpenChannelDetails}"
                    Command="{Binding OpenChannelDetailsCommand}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE946;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="15"
                           Foreground="#55C7FF"
                           Margin="0,0,7,0"
                           VerticalAlignment="Center" />
                <TextBlock Text="通道详情"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>

        </DockPanel>

        <Border Grid.Row="2"
                Background="#02070D"
                BorderBrush="#164869"
                BorderThickness="1"
                CornerRadius="2"
                ClipToBounds="True">
          <Grid>
            <Viewbox Stretch="Uniform"
                     StretchDirection="Both"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Margin="0,14,0,0">
              <Grid Width="{Binding PreviewDesignWidth}" Height="{Binding PreviewDesignHeight}">
                <Border Background="#D1D6D9">
                  <Image Source="{Binding SelectedImagePath}" Stretch="Fill" />
                </Border>
              </Grid>
            </Viewbox>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource MonitorPanelStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="1" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="1" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="传送带速度" Style="{StaticResource MonitorLabelTextStyle}" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding ConveyorSpeedValue}"
                     Foreground="#2F95FF"
                     FontSize="28"
                     FontWeight="Bold"
                     HorizontalAlignment="Center"
                     Margin="0,4,0,0" />
        </StackPanel>
        <Border Grid.Column="1" Width="1" Height="42" Background="#123A58" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="本次已检测" Style="{StaticResource MonitorLabelTextStyle}" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding TotalDetectedCountValue}"
                     Foreground="#2F95FF"
                     FontSize="28"
                     FontWeight="Bold"
                     HorizontalAlignment="Center"
                     Margin="0,4,0,0" />
        </StackPanel>
        <Border Grid.Column="3" Width="1" Height="42" Background="#123A58" VerticalAlignment="Center" />
        <StackPanel Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="工作时长" Style="{StaticResource MonitorLabelTextStyle}" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding WorkDurationValue}"
                     Foreground="#2F95FF"
                     FontSize="28"
                     FontWeight="Bold"
                     HorizontalAlignment="Center"
                     Margin="0,4,0,0" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="0.974*" />
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource MonitorPanelStyle}" Padding="16,12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="92" />
            <RowDefinition Height="32" />
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
          </Grid.RowDefinitions>

          <TextBlock Text="检测统计" Style="{StaticResource MonitorTitleTextStyle}" />

          <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="122" />
              <ColumnDefinition Width="1" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="218" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="任务良率" Style="{StaticResource MonitorLabelTextStyle}" />
              <TextBlock Text="{Binding YieldRateValue}"
                         Foreground="{Binding YieldRateColor}"
                         FontSize="30"
                         FontWeight="Bold"
                         Margin="0,3,0,0" />
            </StackPanel>
            <Border Grid.Column="1"
                    Width="1"
                    Height="54"
                    Background="#164869"
                    VerticalAlignment="Center" />
            <Grid Grid.Column="2" Margin="18,0,22,0" VerticalAlignment="Center">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid Margin="0,0,0,8">
                <TextBlock Text="{Binding YieldStatusText}"
                           Foreground="{Binding YieldRateColor}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Left" />
                <Grid IsHitTestVisible="False">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding YieldTargetLeftWidth}" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{Binding YieldTargetRightWidth}" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="1"
                             Text="{Binding YieldTargetText}"
                             Foreground="#E8F2FF"
                             FontSize="12"
                             HorizontalAlignment="Center" />
                </Grid>
              </Grid>
              <Grid Grid.Row="1" Height="18" ClipToBounds="False">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding YieldWarningZoneWidth}" />
                    <ColumnDefinition Width="{Binding YieldApproachZoneWidth}" />
                    <ColumnDefinition Width="{Binding YieldPassZoneWidth}" />
                  </Grid.ColumnDefinitions>
                  <Border Background="#4A2630" CornerRadius="4,0,0,4" />
                  <Border Grid.Column="1" Background="#4A4025" />
                  <Border Grid.Column="2" Background="#1B4538" CornerRadius="0,4,4,0" />
                </Grid>
                <ProgressBar Style="{StaticResource YieldDistributionBarStyle}"
                             Maximum="100"
                             Value="{Binding YieldRatePercent, Mode=OneWay}"
                             VerticalAlignment="Center" />
                <Grid IsHitTestVisible="False">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding YieldTargetLeftWidth}" />
                    <ColumnDefinition Width="2" />
                    <ColumnDefinition Width="{Binding YieldTargetRightWidth}" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="1"
                          Width="2"
                          Height="24"
                          Background="#F5FAFF"
                          VerticalAlignment="Center" />
                </Grid>
              </Grid>
              <Grid Grid.Row="2" Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{Binding YieldWarningZoneWidth}" />
                  <ColumnDefinition Width="{Binding YieldApproachZoneWidth}" />
                  <ColumnDefinition Width="{Binding YieldPassZoneWidth}" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="0%" Foreground="#708EA6" FontSize="10" HorizontalAlignment="Left" />
                <TextBlock Text="50%" Foreground="#708EA6" FontSize="10" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="1" Text="80%" Foreground="#9DB5C8" FontSize="10" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2" Text="100%" Foreground="#708EA6" FontSize="10" HorizontalAlignment="Right" />
              </Grid>
            </Grid>
            <Grid Grid.Column="3" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <Ellipse Width="8" Height="8" Fill="#25D89B" Margin="0,0,7,0" VerticalAlignment="Center" />
                  <TextBlock Text="正常" Foreground="#9FB6C9" FontSize="13" />
                </StackPanel>
                <TextBlock Text="{Binding NormalDetectedCountValue}"
                           Foreground="#25D89B"
                           FontSize="22"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0" />
              </StackPanel>
              <Border Grid.Column="1" Width="1" Height="46" Background="#164869" VerticalAlignment="Center" />
              <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <Ellipse Width="8" Height="8" Fill="#F04A4F" Margin="0,0,7,0" VerticalAlignment="Center" />
                  <TextBlock Text="异常" Foreground="#9FB6C9" FontSize="13" />
                </StackPanel>
                <TextBlock Text="{Binding RejectedDetectedCountValue}"
                           Foreground="#F04A4F"
                           FontSize="22"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0" />
              </StackPanel>
            </Grid>
          </Grid>

          <Border Grid.Row="2"
                  Background="Transparent"
                  BorderBrush="#123A58"
                  BorderThickness="0,0,0,1"
                  CornerRadius="3"
                  Padding="0"
                  Margin="0,0,0,8">
            <DockPanel LastChildFill="False">
              <TextBlock Text="{Binding CurrentFrameTargetSummary}"
                         Foreground="#E8F2FF"
                         FontSize="15"
                         FontWeight="Bold"
                         VerticalAlignment="Center"
                         DockPanel.Dock="Left" />
              <ItemsControl ItemsSource="{Binding FrameTraitItems}"
                            DockPanel.Dock="Right"
                            VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Foreground="{Binding Color}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="16,0,0,0">
                      <TextBlock.Text>
                        <MultiBinding StringFormat="● {0} {1}">
                          <Binding Path="Label" />
                          <Binding Path="CountText" />
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DockPanel>
          </Border>

          <DockPanel Grid.Row="3" VerticalAlignment="Center" Margin="0,0,0,4">
            <TextBlock Text="本次任务累计 · 缺陷明细"
                       Foreground="#E8F2FF"
                       FontSize="15"
                       FontWeight="SemiBold"
                       DockPanel.Dock="Left" />
            <TextBlock Text="{Binding TotalTraitKindText}"
                       Foreground="#B2C7DB"
                       FontSize="14"
                       DockPanel.Dock="Right"
                       VerticalAlignment="Center" />
          </DockPanel>

          <ItemsControl Grid.Row="4" ItemsSource="{Binding DefectCountItems}" Margin="0,0,0,8">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Height="30" Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="72" />
                  </Grid.ColumnDefinitions>
                  <Border Width="4"
                          Height="16"
                          Background="{Binding Color}"
                          CornerRadius="2"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding Label}"
                             Foreground="#E8F2FF"
                             FontSize="14"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                  <Grid Grid.Column="2" Height="8" VerticalAlignment="Center">
                    <Border Background="#23445F" CornerRadius="4" />
                    <Border Width="{Binding BarWidth}"
                            Background="{Binding Color}"
                            CornerRadius="4"
                            HorizontalAlignment="Left" />
                  </Grid>
                  <TextBlock Grid.Column="3"
                             Text="{Binding CountText}"
                             Foreground="{Binding Color}"
                             FontSize="14"
                             FontWeight="SemiBold"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="4"
                             Text="{Binding PercentText}"
                             Foreground="#B2C7DB"
                             FontSize="14"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button Grid.Row="5"
                  MinHeight="28"
                  Padding="0"
                  Background="#061A2B"
                  BorderBrush="#164869"
                  BorderThickness="1"
                  Foreground="#B2C7DB">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="查看全部类别" FontSize="14" />
              <Image Source="/Assets/Figma/button-chevron.png" Width="18" Height="18" Margin="8,0,0,0" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource MonitorPanelStyle}" Padding="16,12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="40" />
            <RowDefinition Height="8" />
            <RowDefinition Height="50" />
            <RowDefinition Height="30" />
            <RowDefinition Height="42" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" MinHeight="112" />
          </Grid.RowDefinitions>

          <TextBlock Text="主控工作台" Style="{StaticResource MonitorTitleTextStyle}" />

          <Border Grid.Row="1"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="12,0">
            <DockPanel LastChildFill="False">
              <TextBlock Text="设备状态"
                         Style="{StaticResource MonitorLabelTextStyle}"
                         VerticalAlignment="Center"
                         DockPanel.Dock="Left" />
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Ellipse Width="16" Height="16" Fill="{Binding HudDetectionStatusColor}" Margin="0,0,8,0">
                  <Ellipse.Style>
                    <Style TargetType="Ellipse">
                      <Style.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                          <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                              <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                               From="1"
                                               To="0.32"
                                               Duration="0:0:0.75" />
                            </Storyboard>
                          </BeginStoryboard>
                        </EventTrigger>
                      </Style.Triggers>
                    </Style>
                  </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding HudDetectionStatusText}"
                           Foreground="{Binding HudDetectionStatusColor}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
              </StackPanel>
            </DockPanel>
          </Border>

          <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="104" />
            </Grid.ColumnDefinitions>
            <Button MinHeight="50"
                    Padding="0"
                    Background="{Binding MachineControlBackground}"
                    Foreground="{Binding MachineControlForeground}"
                    BorderBrush="{Binding MachineControlBorder}"
                    BorderThickness="1"
                    Command="{Binding ToggleMachineCommand}"
                    IsEnabled="{Binding CanToggleMachine}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="/Assets/Figma/button-stop.png"
                       Width="22"
                       Height="22"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0" />
                <TextBlock Text="{Binding MachineControlText}"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Grid.Column="2"
                    MinHeight="50"
                    Padding="12,0"
                    Background="#101B2A"
                    Foreground="#C9D9E8"
                    BorderBrush="#3B5870"
                    BorderThickness="1"
                    Command="{Binding ResetMachineCommand}"
                    IsEnabled="{Binding CanResetMachine}">
              <TextBlock Text="重置"
                         FontSize="16"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center" />
            </Button>
          </Grid>

          <TextBlock Grid.Row="4"
                     Text="数据源"
                     Style="{StaticResource MonitorLabelTextStyle}"
                     VerticalAlignment="Center" />

          <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button MinHeight="42"
                    Padding="0"
                    Background="{Binding XrayCameraSourceBackground}"
                    Foreground="#E8F2FF"
                    BorderBrush="{Binding XrayCameraSourceBorder}"
                    BorderThickness="1"
                    Command="{Binding UseXrayCameraDataSourceCommand}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="/Assets/Figma/source-xray.png" Width="20" Height="20" Margin="0,0,8,0" />
                <TextBlock Text="X 光相机" FontSize="15" FontWeight="SemiBold" />
              </StackPanel>
            </Button>
            <Button Grid.Column="2"
                    MinHeight="42"
                    Padding="0"
                    Background="{Binding LocalDirectorySourceBackground}"
                    Foreground="#E8F2FF"
                    BorderBrush="{Binding LocalDirectorySourceBorder}"
                    BorderThickness="1"
                    Command="{Binding SelectFolderCommand}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="/Assets/Figma/source-offline.png" Width="20" Height="20" Margin="0,0,8,0" />
                <TextBlock Text="离线图片" FontSize="15" FontWeight="SemiBold" />
              </StackPanel>
            </Button>
          </Grid>

          <Border Grid.Row="7"
                  Background="#061A2B"
                  BorderBrush="#164869"
                  BorderThickness="1"
                  CornerRadius="4"
                  Padding="10,8">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="24" />
                <RowDefinition Height="30" />
                <RowDefinition Height="*" MinHeight="42" />
              </Grid.RowDefinitions>

              <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                  <TextBlock Text="图片批次"
                             Foreground="#B2C7DB"
                             FontSize="14"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{Binding DataSourceModeText}"
                             Foreground="#B2C7DB"
                             FontSize="14"
                             FontWeight="SemiBold"
                             Margin="2,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding DataSourceBatchTitleText}"
                           Foreground="#E8F2FF"
                           FontSize="13"
                           FontWeight="Bold"
                           TextTrimming="CharacterEllipsis"
                           DockPanel.Dock="Right" />
              </DockPanel>

              <TextBlock Grid.Row="1"
                         Text="{Binding DataSourceDirectoryText}"
                         Foreground="#8FA8C2"
                         FontSize="12"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />

              <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="88" />
                  <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <Grid Height="8" VerticalAlignment="Center" Margin="0,0,14,0">
                  <Border Background="#23445F" CornerRadius="4" />
                  <Border Background="#2F95FF" CornerRadius="4" />
                </Grid>
                <Button Grid.Column="2"
                        Width="140"
                        Height="34"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Padding="0"
                        Background="#082137"
                        BorderBrush="#2489D6"
                        BorderThickness="1"
                        Foreground="#E8F2FF"
                        Command="{Binding SelectFolderCommand}">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="/Assets/Figma/button-refresh-source.png" Width="18" Height="18" Margin="0,0,7,0" />
                    <TextBlock Text="更新图片源" FontSize="14" FontWeight="SemiBold" />
                  </StackPanel>
                </Button>
                <TextBlock Grid.Column="1"
                           Text="{Binding DataSourceProgressCompactText}"
                           Foreground="#2F95FF"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.RowSpan="6"
            Panel.ZIndex="50"
            Background="#99020914"
            Visibility="{Binding IsChannelDetailsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
      <Border Width="920"
              Height="580"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Background="#071D31"
              BorderBrush="#2D6C94"
              BorderThickness="1"
              CornerRadius="6">
        <Border.Effect>
          <DropShadowEffect Color="#000000" BlurRadius="34" ShadowDepth="16" Opacity="0.48" />
        </Border.Effect>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="424" />
            <RowDefinition Height="84" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0"
                  Background="#09253E"
                  BorderBrush="#244B68"
                  BorderThickness="0,0,0,1"
                  CornerRadius="6,6,0,0" />

          <TextBlock Text="通道详情"
                     Foreground="#F2F7FC"
                     FontSize="25"
                     FontWeight="Bold"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
          <Button Width="48"
                  Height="48"
                  Margin="0,10,12,0"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Background="Transparent"
                  BorderThickness="0"
                  Foreground="#E8F2FF"
                  FontSize="30"
                  FontWeight="Light"
                  Content="×"
                  Command="{Binding CloseChannelDetailsCommand}" />

          <Grid Grid.Row="1" Margin="24,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="400" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="456" />
            </Grid.ColumnDefinitions>

            <Border Background="#071C2F" BorderBrush="#2A5877" BorderThickness="1" CornerRadius="3" Padding="14">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="34" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="通道列表" Foreground="#DCEAF5" FontSize="16" FontWeight="SemiBold" />
                <ListBox Grid.Row="1"
                         Margin="0,6,0,0"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemsSource="{Binding ChannelOptions}"
                         SelectedItem="{Binding SelectedChannelOption}"
                         ItemContainerStyle="{StaticResource ChannelDialogListItemStyle}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid Height="64">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" Foreground="#F0F6FC" FontSize="20" FontWeight="Bold" />
                          <TextBlock Foreground="#AFC1D2" FontSize="14" Margin="0,5,0,0">
                            <Run Text="{Binding ProductName}" /><Run Text=" · " /><Run Text="{Binding ModelVersion}" />
                          </TextBlock>
                        </StackPanel>
                        <Grid x:Name="CurrentChannelLabel"
                              Grid.Column="1"
                              Height="24"
                              VerticalAlignment="Center"
                              Visibility="Collapsed">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Ellipse Width="8"
                                   Height="8"
                                   Fill="#20D98B"
                                   VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1"
                                     Margin="8,0,0,0"
                                     Text="当前使用"
                                     Foreground="#20D98B"
                                     FontSize="13"
                                     FontWeight="SemiBold"
                                     LineHeight="20"
                                     LineStackingStrategy="BlockLineHeight"
                                     VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="SelectedChannelLabel"
                                   Grid.Column="1"
                                   Text="已选择"
                                   Foreground="#DCEAF5"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                      </Grid>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                          <Setter TargetName="CurrentChannelLabel" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <MultiDataTrigger>
                          <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsCurrent}" Value="False" />
                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                          </MultiDataTrigger.Conditions>
                          <Setter TargetName="SelectedChannelLabel" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>

            <Border Grid.Column="2" Background="#071C2F" BorderBrush="#2A5877" BorderThickness="1" CornerRadius="3" Padding="18">
              <Grid DataContext="{Binding SelectedChannelOption}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="46" />
                  <RowDefinition Height="62" />
                  <RowDefinition Height="62" />
                  <RowDefinition Height="62" />
                  <RowDefinition Height="72" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="通道详情" Foreground="#DCEAF5" FontSize="16" FontWeight="SemiBold" />

                <Grid Grid.Row="1">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="138" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Text="通道" Foreground="#9FB4C9" FontSize="15" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#F0F6FC" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Border Grid.ColumnSpan="2" Height="1" Background="#244B68" VerticalAlignment="Bottom" />
                </Grid>
                <Grid Grid.Row="2">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="138" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Text="海鲜产品" Foreground="#9FB4C9" FontSize="15" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding ProductName}" Foreground="#F0F6FC" FontSize="16" VerticalAlignment="Center" />
                  <Border Grid.ColumnSpan="2" Height="1" Background="#244B68" VerticalAlignment="Bottom" />
                </Grid>
                <Grid Grid.Row="3">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="138" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Text="绑定模型" Foreground="#9FB4C9" FontSize="15" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding ModelVersion}" Foreground="#F0F6FC" FontSize="16" VerticalAlignment="Center" />
                  <Border Grid.ColumnSpan="2" Height="1" Background="#244B68" VerticalAlignment="Bottom" />
                </Grid>
                <Grid Grid.Row="4">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="138" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Text="缺陷类型" Foreground="#9FB4C9" FontSize="15" VerticalAlignment="Center" />
                  <ItemsControl Grid.Column="1"
                                ItemsSource="{Binding DefectTypes}"
                                VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Margin="0,0,8,0"
                                Padding="10,5"
                                Background="#0A263B"
                                BorderBrush="#365F7A"
                                BorderThickness="1"
                                CornerRadius="4">
                          <TextBlock Text="{Binding}"
                                     Foreground="#DCEBFA"
                                     FontSize="13"
                                     LineHeight="18"
                                     LineStackingStrategy="BlockLineHeight" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </Grid>
            </Border>
          </Grid>

          <Border Grid.Row="2"
                  Background="#06192B"
                  BorderBrush="#244B68"
                  BorderThickness="0,1,0,0"
                  CornerRadius="0,0,6,6" />
          <Grid Grid.Row="2" Margin="24,0">
            <Grid Height="24" HorizontalAlignment="Left" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Ellipse Width="9"
                       Height="9"
                       Fill="{Binding ChannelDialogStatusColor}"
                       VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Margin="9,0,0,0"
                         Text="{Binding ChannelDialogStatusText}"
                         Foreground="{Binding ChannelDialogStatusColor}"
                         FontSize="14"
                         LineHeight="20"
                         LineStackingStrategy="BlockLineHeight"
                         VerticalAlignment="Center" />
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button Width="112"
                      Height="44"
                      Margin="0,0,12,0"
                      Background="#091F34"
                      BorderBrush="#52758E"
                      BorderThickness="1"
                      Foreground="#E8F2FF"
                      FontSize="15"
                      Content="取消"
                      Command="{Binding CloseChannelDetailsCommand}" />
              <Button Width="144"
                      Height="44"
                      Background="#087DE6"
                      BorderBrush="#29B3FF"
                      BorderThickness="1"
                      Foreground="#FFFFFF"
                      FontSize="15"
                      FontWeight="SemiBold"
                      Content="切换"
                      Command="{Binding ApplySelectedChannelCommand}"
                      IsEnabled="{Binding CanApplyChannelSelection}" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Border>
  </Grid>
</UserControl>
