<UserControl x:Class="OceanFresh.SortingSystem.HMI.Pages.ChannelConfigsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Border Background="{StaticResource PanelBackground}" CornerRadius="18" Padding="24">
      <StackPanel>
        <DockPanel Margin="0,0,0,18">
          <StackPanel>
            <TextBlock Text="通道配置列表" Foreground="{StaticResource TextBrush}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="先按海鲜产品筛选，再通过通道名称搜索并进入详情页。"
                       Foreground="{StaticResource MutedTextBrush}"
                       Margin="0,8,0,0" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
            <Button Padding="16,10"
                    Background="{StaticResource AccentBrush}"
                    Foreground="#08121B"
                    BorderThickness="0"
                    FontWeight="Bold"
                    MinWidth="104"
                    Command="{Binding OpenCreateChannelCommand}">
              <TextBlock Text="新建通道" />
            </Button>
            <Button Margin="10,0,0,0"
                    Padding="16,10"
                    Background="{StaticResource SurfaceBrush}"
                    Foreground="{StaticResource TextBrush}"
                    BorderThickness="0"
                    MinWidth="96"
                    Command="{Binding RefreshCommand}">
              <TextBlock Text="刷新列表" />
            </Button>
          </StackPanel>
        </DockPanel>

        <Border Background="{StaticResource SurfaceSoftBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,18">
          <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
        </Border>

        <Grid Margin="0,0,0,18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,12,0">
            <TextBlock Text="搜索通道名称" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
            <Border Background="{StaticResource SurfaceSoftBrush}" CornerRadius="12" Padding="14">
              <TextBox Text="{Binding ChannelSearchText, UpdateSourceTrigger=PropertyChanged}"
                       Background="Transparent"
                       BorderThickness="0"
                       Foreground="{StaticResource TextBrush}" />
            </Border>
            <TextBlock Text="输入通道名关键字，例如“1号通道”。"
                       Foreground="{StaticResource MutedTextBrush}"
                       Margin="0,8,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,12,0">
            <TextBlock Text="海鲜产品筛选" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
            <Border Background="{StaticResource SurfaceSoftBrush}" CornerRadius="12" Padding="10">
              <ComboBox ItemsSource="{Binding ProductFilterOptions}"
                        SelectedItem="{Binding SelectedProductFilter}"
                        Background="Transparent"
                        BorderThickness="0" />
            </Border>
            <TextBlock Text="{Binding ActiveChannelSummary}"
                       Foreground="{StaticResource TextBrush}"
                       Margin="0,8,0,0"
                       FontWeight="SemiBold" />
          </StackPanel>
          <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="16">
            <StackPanel>
              <TextBlock Text="详情页启停" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
              <TextBlock Text="点击列表里的“查看详情”后，可以在详情页启用或停用通道。启用新通道时会提示同时停用哪个通道。"
                         Foreground="{StaticResource MutedTextBrush}"
                         Margin="0,8,0,0"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>

        <DataGrid ItemsSource="{Binding Channels}"
                  SelectedItem="{Binding SelectedChannel}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  Background="{StaticResource SurfaceSoftBrush}"
                  Foreground="{StaticResource TextBrush}"
                  BorderThickness="0"
                  RowBackground="{StaticResource SurfaceSoftBrush}"
                  AlternatingRowBackground="{StaticResource SurfaceBrush}"
                  MinHeight="500">
          <DataGrid.Columns>
            <DataGridTextColumn Header="运行状态" Binding="{Binding RunningStatus}" Width="0.9*" />
            <DataGridTextColumn Header="通道" Binding="{Binding Name}" Width="*" />
            <DataGridTextColumn Header="海鲜产品" Binding="{Binding ProductName}" Width="*" />
            <DataGridTextColumn Header="模型" Binding="{Binding ModelVersion}" Width="*" />
            <DataGridTextColumn Header="动作" Binding="{Binding DefectAction}" Width="*" />
            <DataGridTextColumn Header="置信度阈值" Binding="{Binding ConfidenceThreshold}" Width="*" />
            <DataGridTemplateColumn Header="详情" Width="0.9*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Padding="10,6"
                          Background="{StaticResource SurfaceBrush}"
                          Foreground="{StaticResource TextBrush}"
                          BorderThickness="0"
                          Command="{Binding DataContext.OpenChannelDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}">
                    <TextBlock Text="查看详情" />
                  </Button>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
          <Button Padding="18,12"
                  Background="{StaticResource AccentMutedBrush}"
                  Foreground="#08121B"
                  BorderThickness="0"
                  FontWeight="Bold"
                  MinWidth="120"
                  Visibility="{Binding HasSelectedChannel, Converter={StaticResource BoolToVisibilityConverter}}"
                  Command="{Binding OpenEditChannelCommand}">
            <TextBlock Text="编辑选中通道" />
          </Button>
          <Button Margin="12,0,0,0"
                  Padding="18,12"
                  Background="{StaticResource DangerBrush}"
                  Foreground="{StaticResource TextBrush}"
                  BorderThickness="0"
                  MinWidth="96"
                  Visibility="{Binding HasSelectedChannel, Converter={StaticResource BoolToVisibilityConverter}}"
                  Command="{Binding DeleteChannelCommand}">
            <TextBlock Text="删除通道" />
          </Button>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
