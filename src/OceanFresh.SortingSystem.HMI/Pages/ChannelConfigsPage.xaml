<UserControl x:Class="OceanFresh.SortingSystem.HMI.Pages.ChannelConfigsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextHintingMode="Fixed">
  <Border Background="#0B2136"
          BorderBrush="#31465A"
          BorderThickness="1"
          CornerRadius="5"
          Padding="24">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="44" />
        <RowDefinition Height="*" />
        <RowDefinition Height="72" />
      </Grid.RowDefinitions>

      <DockPanel Margin="0,0,0,18" LastChildFill="False">
        <StackPanel>
          <TextBlock Text="通道配置" Foreground="#EAF4FF" FontSize="26" FontWeight="SemiBold" />
        </StackPanel>
        <Button DockPanel.Dock="Right"
                Style="{StaticResource SettingsListAddButtonStyle}"
                Command="{Binding OpenCreateChannelCommand}">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="＋" FontSize="18" FontWeight="Normal" VerticalAlignment="Center" />
            <TextBlock Text="添加通道" Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </DockPanel>

      <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="440"
                Margin="0,0,24,0"
                Style="{StaticResource SettingsListSearchContainerStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="22" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE721;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="15"
                       Foreground="#73A7C7"
                       VerticalAlignment="Center" />
            <TextBox Grid.Column="1"
                     Style="{StaticResource SettingsListSearchTextBoxStyle}"
                     Text="{Binding ChannelSearchText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="搜索通道、海鲜产品或模型" />
          </Grid>
        </Border>
        <TextBlock Text="海鲜产品" Style="{StaticResource SettingsListFilterLabelStyle}" />
        <ComboBox Width="238"
                  Style="{StaticResource SettingsListFilterComboBoxStyle}"
                  ItemsSource="{Binding ProductFilterOptions}"
                  SelectedItem="{Binding SelectedProductFilter}" />
      </StackPanel>

      <DataGrid Grid.Row="2"
                Margin="0,14,0,14"
                Style="{StaticResource SettingsListDataGridStyle}"
                ItemsSource="{Binding VisibleChannels}"
                SelectedItem="{Binding SelectedChannel}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                IsReadOnly="True"
                SelectionUnit="FullRow"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="使用状态" Width="1*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="16,0">
                  <Ellipse Width="12" Height="12" Margin="0,0,10,0">
                    <Ellipse.Style>
                      <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="#63788B" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="Fill" Value="#20D98B" />
                            <Setter Property="Effect">
                              <Setter.Value>
                                <DropShadowEffect Color="#20D98B" BlurRadius="7" ShadowDepth="0" Opacity="0.45" />
                              </Setter.Value>
                            </Setter>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Ellipse.Style>
                  </Ellipse>
                  <TextBlock Text="{Binding RunningStatus}" FontWeight="SemiBold" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsListTextCellStyle}">
                        <Setter Property="Foreground" Value="#B8CADD" />
                        <Setter Property="Margin" Value="0" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="Foreground" Value="#20D98B" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="通道"
                              Binding="{Binding Name}"
                              Width="1*"
                              ElementStyle="{StaticResource SettingsListTextCellStyle}" />
          <DataGridTextColumn Header="海鲜产品"
                              Binding="{Binding ProductName}"
                              Width="1*"
                              ElementStyle="{StaticResource SettingsListTextCellStyle}" />
          <DataGridTextColumn Header="模型"
                              Binding="{Binding ModelVersion}"
                              Width="1.2*"
                              ElementStyle="{StaticResource SettingsListTextCellStyle}" />
          <DataGridTemplateColumn Header="操作" Width="180">
            <DataGridTemplateColumn.HeaderStyle>
              <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource SettingsListColumnHeaderStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
              </Style>
            </DataGridTemplateColumn.HeaderStyle>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Button Style="{StaticResource SettingsListActionButtonStyle}"
                          Tag="{StaticResource SettingsPreviewIconGeometry}"
                          Command="{Binding DataContext.OpenChannelDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}"
                          ToolTip="预览通道" />
                  <Button Style="{StaticResource SettingsListActionButtonStyle}"
                          Tag="{StaticResource SettingsEditIconGeometry}"
                          Margin="12,0,0,0"
                          Command="{Binding DataContext.OpenEditChannelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}"
                          ToolTip="编辑通道" />
                  <Button Style="{StaticResource SettingsListDangerButtonStyle}"
                          Tag="{StaticResource SettingsDeleteIconGeometry}"
                          Margin="12,0,0,0"
                          Command="{Binding DataContext.DeleteChannelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}"
                          ToolTip="删除通道" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <Grid Grid.Row="3">
        <TextBlock Text="{Binding Channels.Count, StringFormat=共 {0} 条}"
                   Foreground="#EAF4FF"
                   FontSize="15"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
          <Button Style="{StaticResource UnifiedPagerButtonStyle}"
                  Command="{Binding PreviousPageCommand}"
                  IsEnabled="{Binding CanGoToPreviousPage}"
                  Content="‹" />
          <TextBlock Text="{Binding PageSummary}" Width="64" Margin="8,0"
                     Foreground="#DCEAF5" FontSize="14" TextAlignment="Center" VerticalAlignment="Center" />
          <Button Style="{StaticResource UnifiedPagerButtonStyle}"
                  Command="{Binding NextPageCommand}"
                  IsEnabled="{Binding CanGoToNextPage}"
                  Content="›" />
          <TextBlock Text="每页" Margin="20,0,8,0" Foreground="#8FA9C1" FontSize="13" VerticalAlignment="Center" />
          <ComboBox Width="78" Height="34" MinHeight="34" Padding="8,4"
                    ItemsSource="{Binding PageSizeOptions}" DisplayMemberPath="Value"
                    SelectedValuePath="Value" SelectedValue="{Binding SelectedPageSize}"
                    Background="#0D2942" BorderBrush="#31465A" BorderThickness="1" />
          <TextBlock Text="条" Margin="8,0,0,0" Foreground="#8FA9C1" FontSize="13" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>
