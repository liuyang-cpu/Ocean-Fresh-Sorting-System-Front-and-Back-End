<UserControl x:Class="OceanFresh.SortingSystem.HMI.Pages.ProductEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
  <Grid Background="{StaticResource SettingsEditorBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="64" />
      <RowDefinition Height="*" />
      <RowDefinition Height="72" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="24,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0"
              VerticalAlignment="Center"
              Margin="0,0,18,0"
              Style="{StaticResource SettingsEditorReturnButtonStyle}"
              Command="{Binding BackToListCommand}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Viewbox Width="16" Height="16" Margin="0,0,8,0">
            <Path Data="{StaticResource SettingsBackIconGeometry}"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.8"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />
          </Viewbox>
          <TextBlock Text="返回列表" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <TextBlock Grid.Column="1"
                 FontSize="26"
                 FontWeight="SemiBold"
                 Foreground="#EAF4FF"
                 VerticalAlignment="Center">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Text" Value="添加海鲜产品" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsEditing}" Value="True">
                <Setter Property="Text" Value="编辑海鲜产品" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="16,8,16,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="1.08*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Style="{StaticResource SettingsEditorCardStyle}"
                Padding="24,20">
          <StackPanel>
            <TextBlock Style="{StaticResource SettingsEditorLabelStyle}" Margin="0,0,0,8">
              <Run Text="海鲜名称" /><Run Text=" *" Foreground="#18B8F2" />
            </TextBlock>
            <Border Style="{StaticResource SettingsEditorInputFrameStyle}" Margin="0,0,0,22">
              <Grid>
                <TextBox x:Name="ProductNameEditor"
                         Text="{Binding DraftProductName, UpdateSourceTrigger=PropertyChanged}"
                         Foreground="#EAF4FF"
                         FontSize="15"
                         VerticalContentAlignment="Center" />
                <TextBlock Text="请输入海鲜名称"
                           IsHitTestVisible="False"
                           Foreground="#6F879C"
                           FontSize="14"
                           VerticalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=ProductNameEditor}" Value="">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Text, ElementName=ProductNameEditor}" Value="{x:Null}">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
            </Border>

            <TextBlock Text="缺陷项"
                       Style="{StaticResource SettingsEditorSectionTitleStyle}"
                       Margin="0,0,0,12" />
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="168" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource SettingsEditorInputFrameStyle}">
                <Grid>
                  <TextBox x:Name="PendingDefectEditor"
                           Text="{Binding PendingDefectName, UpdateSourceTrigger=PropertyChanged}"
                           Foreground="#EAF4FF"
                           FontSize="15"
                           VerticalContentAlignment="Center" />
                  <TextBlock Text="请输入缺陷名称"
                             IsHitTestVisible="False"
                             Foreground="#6F879C"
                             FontSize="14"
                             VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Text, ElementName=PendingDefectEditor}" Value="">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Text, ElementName=PendingDefectEditor}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
              </Border>
              <Button Grid.Column="2"
                      Height="44"
                      MinHeight="44"
                      Background="Transparent"
                      Foreground="#EAF4FF"
                      BorderBrush="#315873"
                      BorderThickness="1"
                      Padding="16,0"
                      Command="{Binding AddDefectCommand}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <TextBlock Text="&#xE710;"
                             FontFamily="Segoe MDL2 Assets"
                             FontSize="16"
                             VerticalAlignment="Center" />
                  <TextBlock Text="添加" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>

            <Border Style="{StaticResource SettingsEditorCardStyle}" Margin="0,0,0,22">
              <StackPanel>
                <Grid Height="46" Background="#0C2941">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="160" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="性状名称" Style="{StaticResource SettingsEditorLabelStyle}" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="类型" Style="{StaticResource SettingsEditorLabelStyle}" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="操作" Style="{StaticResource SettingsEditorLabelStyle}" HorizontalAlignment="Center" />
                </Grid>
                <Grid Height="50">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="160" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.ColumnSpan="3" BorderBrush="{StaticResource SettingsEditorBorderBrush}" BorderThickness="0,1,0,0" />
                  <TextBlock Text="正常" Foreground="#EAF4FF" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="正常类" Foreground="#C8D7E4" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="#7890A4" FontSize="15" VerticalAlignment="Center" />
                    <TextBlock Text="锁定" Foreground="#7890A4" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
                <ItemsControl ItemsSource="{Binding DefectItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Height="50">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="1.2*" />
                          <ColumnDefinition Width="1*" />
                          <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="3" BorderBrush="{StaticResource SettingsEditorBorderBrush}" BorderThickness="0,1,0,0" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Foreground="#EAF4FF"
                                 FontSize="15"
                                 TextAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Margin="12,2" />
                        <TextBlock Grid.Column="1"
                                   Text="缺陷类"
                                   Foreground="#C8D7E4"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <Button Style="{StaticResource SettingsEditorCompactIconButtonStyle}"
                                  ToolTip="删除缺陷"
                                  Command="{Binding DataContext.RemoveDefectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}">
                            <Path Data="{StaticResource SettingsDeleteIconGeometry}"
                                  Stroke="#FF5364"
                                  StrokeThickness="1.8"
                                  Width="18"
                                  Height="18"
                                  Stretch="Uniform" />
                          </Button>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SettingsEditorLabelStyle}" Margin="0,0,0,8">
              <Run Text="标签文件" /><Run Text=" *" Foreground="#18B8F2" />
            </TextBlock>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="48" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource SettingsEditorInputFrameStyle}">
                <TextBox Text="{Binding SelectedClassesFilePath, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="True"
                         Foreground="#EAF4FF"
                         FontSize="14"
                         VerticalContentAlignment="Center" />
              </Border>
              <Button Grid.Column="2"
                      Style="{StaticResource SettingsEditorIconButtonStyle}"
                      ToolTip="选择标签文件"
                      Command="{Binding BrowseClassesFileCommand}">
                <Path Data="M4,1 L13,1 L18,6 L18,23 L4,23 Z M13,1 L13,6 L18,6"
                      Width="18"
                      Height="20"
                      Stretch="Uniform"
                      Fill="Transparent"
                      Stroke="#6BC9FF"
                      StrokeThickness="1.6"
                      StrokeLineJoin="Round" />
              </Button>
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Column="2"
                Style="{StaticResource SettingsEditorCardStyle}"
                Padding="24,20">
          <StackPanel>
            <DockPanel Margin="0,0,0,12">
              <TextBlock Text="标签映射" Style="{StaticResource SettingsEditorSectionTitleStyle}" />
              <TextBlock DockPanel.Dock="Right"
                         Text="{Binding MappingCompletionText}"
                         Foreground="#8EDB36"
                         FontSize="14"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center" />
            </DockPanel>

            <Border Style="{StaticResource SettingsEditorCardStyle}" Margin="0,0,0,22">
              <StackPanel>
                <Grid Height="46" Background="#0C2941">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="1.25*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="索引" Style="{StaticResource SettingsEditorLabelStyle}" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="模型标签" Style="{StaticResource SettingsEditorLabelStyle}" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="→" Style="{StaticResource SettingsEditorLabelStyle}" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="产品性状" Style="{StaticResource SettingsEditorLabelStyle}" HorizontalAlignment="Center" />
                </Grid>
                <ItemsControl ItemsSource="{Binding TraitMappings}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Height="50">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="72" />
                          <ColumnDefinition Width="1.2*" />
                          <ColumnDefinition Width="44" />
                          <ColumnDefinition Width="1.25*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="4" BorderBrush="{StaticResource SettingsEditorBorderBrush}" BorderThickness="0,1,0,0" />
                        <TextBlock Text="{Binding ClassIndexText}" Foreground="#EAF4FF" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ModelLabel}" Foreground="#EAF4FF" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="→" Foreground="#C8D7E4" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="3"
                                  Height="38"
                                  MinHeight="38"
                                  Margin="10,5"
                                  Padding="12,0"
                                  ItemsSource="{Binding TraitOptions}"
                                  SelectedItem="{Binding SelectedTraitName, UpdateSourceTrigger=PropertyChanged}"
                                  Background="#09243A"
                                  BorderBrush="{StaticResource SettingsEditorBorderBrush}"
                                  BorderThickness="1" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <TextBlock Text="产品后处理参数"
                       Style="{StaticResource SettingsEditorSectionTitleStyle}"
                       Margin="0,0,0,12" />
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="146" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource SettingsEditorInputFrameStyle}">
                <TextBox Text="{Binding SelectedPredictConfigPath}"
                         IsReadOnly="True"
                         Foreground="#EAF4FF"
                         FontSize="14"
                         VerticalContentAlignment="Center" />
              </Border>
              <Button Grid.Column="2"
                      Height="44"
                      MinHeight="44"
                      Background="Transparent"
                      Foreground="#EAF4FF"
                      BorderBrush="#315873"
                      BorderThickness="1"
                      Padding="12,0"
                      Command="{Binding BrowsePredictConfigCommand}">
                <TextBlock Text="选择 JSON" />
              </Button>
              <Button Grid.Column="4"
                      Height="44"
                      MinHeight="44"
                      Background="Transparent"
                      Foreground="#EAF4FF"
                      BorderBrush="#315873"
                      BorderThickness="1"
                      Padding="12,0"
                      Command="{Binding LoadDefaultPredictConfigCommand}">
                <TextBlock Text="默认参数" />
              </Button>
            </Grid>
            <Border Style="{StaticResource SettingsEditorCardStyle}"
                    Background="#061827"
                    Padding="14"
                    Height="172">
              <TextBox Text="{Binding PredictConfigJsonText, UpdateSourceTrigger=PropertyChanged}"
                       AcceptsReturn="True"
                       VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Auto"
                       Foreground="#D7E8F7"
                       FontFamily="Consolas"
                       FontSize="13"
                       TextWrapping="NoWrap" />
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>

    <Border Grid.Row="2"
            Background="#061629"
            BorderBrush="{StaticResource SettingsEditorBorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid Margin="24,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   Text="{Binding StatusMessage}"
                   ToolTip="{Binding StatusMessage}"
                   Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibilityConverter}}"
                   Style="{StaticResource SettingsEditorStatusTextStyle}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Button Style="{StaticResource SettingsEditorPrimaryButtonStyle}"
                Command="{Binding SaveProductCommand}">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
            <TextBlock Text="保存产品" Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
