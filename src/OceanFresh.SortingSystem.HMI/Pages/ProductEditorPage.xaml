<UserControl x:Class="OceanFresh.SortingSystem.HMI.Pages.ProductEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Border Background="{StaticResource PanelBackground}" CornerRadius="18" Padding="24">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <DockPanel Margin="0,0,0,18">
            <StackPanel>
              <TextBlock Text="海鲜产品编辑" Foreground="{StaticResource TextBrush}" FontSize="24" FontWeight="SemiBold" />
              <TextBlock Text="在这里维护海鲜名称和缺陷类型，默认正常标签固定为“正常”。"
                         Foreground="{StaticResource MutedTextBrush}"
                         Margin="0,8,0,0" />
            </StackPanel>
            <Button DockPanel.Dock="Right"
                    Padding="16,10"
                    MinWidth="120"
                    Background="{StaticResource SurfaceBrush}"
                    Foreground="{StaticResource TextBrush}"
                    BorderThickness="0"
                    HorizontalAlignment="Right"
                    Command="{Binding BackToListCommand}">
              <TextBlock Text="返回产品列表" />
            </Button>
          </DockPanel>

          <Border Background="{StaticResource SurfaceSoftBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,18">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
          </Border>

          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="海鲜名称" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
              <Border Background="{StaticResource SurfaceSoftBrush}" CornerRadius="12" Padding="14">
                <TextBox Text="{Binding DraftProductName, UpdateSourceTrigger=PropertyChanged}" Foreground="{StaticResource TextBrush}" FontSize="16" Background="Transparent" BorderThickness="0" />
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="产品编码" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
              <Border Background="{StaticResource SurfaceSoftBrush}" CornerRadius="12" Padding="14">
                <TextBox Text="{Binding DraftProductCode, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding IsCodeReadOnly}"
                         Foreground="{StaticResource TextBrush}"
                         FontSize="16"
                         Background="Transparent"
                         BorderThickness="0" />
              </Border>
            </StackPanel>
          </Grid>

          <StackPanel Margin="0,0,0,14">
            <TextBlock Text="新增缺陷项" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
            <DockPanel LastChildFill="False">
              <Border Background="{StaticResource SurfaceSoftBrush}" CornerRadius="12" Padding="14" Margin="0,0,10,0" Width="420">
                <TextBox Text="{Binding PendingDefectName, UpdateSourceTrigger=PropertyChanged}"
                         Foreground="{StaticResource TextBrush}"
                         FontSize="16"
                         Background="Transparent"
                         BorderThickness="0" />
              </Border>
              <Button Padding="16,10"
                      MinWidth="90"
                      Background="{StaticResource AccentMutedBrush}"
                      Foreground="#08121B"
                      BorderThickness="0"
                      Command="{Binding AddDefectCommand}">
                <TextBlock Text="添加" />
              </Button>
            </DockPanel>
          </StackPanel>

          <Border Background="{StaticResource SurfaceSoftBrush}" CornerRadius="16" Padding="18" Margin="0,0,0,18">
            <StackPanel>
              <TextBlock Text="缺陷项列表" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
              <ItemsControl ItemsSource="{Binding DefectItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="12" Margin="0,0,10,0">
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Foreground="{StaticResource TextBrush}"
                                 Background="Transparent"
                                 BorderThickness="0" />
                      </Border>
                      <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="12" Margin="0,0,10,0">
                        <TextBlock Text="缺陷类" Foreground="{StaticResource MutedTextBrush}" />
                      </Border>
                      <Button Grid.Column="2"
                              Padding="12,8"
                              Background="{StaticResource DangerBrush}"
                              Foreground="{StaticResource TextBrush}"
                              BorderThickness="0"
                              Command="{Binding DataContext.RemoveDefectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}">
                        <TextBlock Text="删除" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal">
            <Button Padding="18,12"
                    Background="{StaticResource AccentBrush}"
                    Foreground="#08121B"
                    BorderThickness="0"
                    FontWeight="Bold"
                    MinWidth="120"
                    Command="{Binding SaveProductCommand}">
              <TextBlock Text="保存海鲜产品" />
            </Button>
            <Button Margin="12,0,0,0"
                    Padding="18,12"
                    Background="{StaticResource DangerBrush}"
                    Foreground="{StaticResource TextBrush}"
                    BorderThickness="0"
                    MinWidth="100"
                    Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibilityConverter}}"
                    Command="{Binding DeleteProductCommand}">
              <TextBlock Text="删除产品" />
            </Button>
            <Button Margin="12,0,0,0"
                    Padding="18,12"
                    Background="{StaticResource SurfaceBrush}"
                    Foreground="{StaticResource TextBrush}"
                    BorderThickness="0"
                    MinWidth="100"
                    Command="{Binding BackToListCommand}">
              <TextBlock Text="取消并返回" />
            </Button>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
