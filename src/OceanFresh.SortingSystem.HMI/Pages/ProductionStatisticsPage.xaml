<UserControl x:Class="OceanFresh.SortingSystem.HMI.Pages.ProductionStatisticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="RangeSegmentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#0A1D2F" />
      <Setter Property="Foreground" Value="#CFE2FF" />
      <Setter Property="BorderBrush" Value="#264D69" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="MinWidth" Value="98" />
      <Setter Property="Height" Value="42" />
      <Setter Property="Padding" Value="14,5" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="Background" Value="#1D83E2" />
          <Setter Property="Foreground" Value="#FFFFFF" />
          <Setter Property="BorderBrush" Value="#2F95FF" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="HardwareNumberTextStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style x:Key="TrendPointButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#60A5FA" />
      <Setter Property="BorderThickness" Value="1.3" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
              <Ellipse Width="8"
                       Height="8"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Fill="#60A5FA"
                       Stroke="{TemplateBinding BorderBrush}"
                       StrokeThickness="{TemplateBinding BorderThickness}">
                <Ellipse.Effect>
                  <DropShadowEffect Color="#60A5FA" BlurRadius="7" ShadowDepth="0" Opacity="0.45" />
                </Ellipse.Effect>
              </Ellipse>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#E0F2FE" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="BorderBrush" Value="#2563EB" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="StatisticsPanelBorderStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource PanelBackground}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderBrush" Value="#338EC7FF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect Color="#4AA3D8" BlurRadius="10" ShadowDepth="0" Opacity="0.12" />
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="HistoryPanelBorderStyle" TargetType="Border">
      <Setter Property="Background" Value="#10243A" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderBrush" Value="#294D68" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="HistoryKpiLabelStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#C6D6E3" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style x:Key="HistoryKpiValueStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#F4FAFF" />
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="FontSize" Value="43" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="HistoryDefectProgressStyle" TargetType="ProgressBar">
      <Setter Property="Height" Value="10" />
      <Setter Property="Background" Value="#294257" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid SnapsToDevicePixels="True">
              <Border x:Name="PART_Track"
                      Background="{TemplateBinding Background}"
                      CornerRadius="5" />
              <Border x:Name="PART_Indicator"
                      HorizontalAlignment="Left"
                      Background="{TemplateBinding Foreground}"
                      CornerRadius="5" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DataCenterTabButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#AFC4D6" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinWidth" Value="140" />
      <Setter Property="Height" Value="46" />
      <Setter Property="Padding" Value="18,6" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <ContentPresenter x:Name="TabContent"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
              <Border x:Name="TabUnderline"
                      Height="3"
                      Width="70"
                      CornerRadius="2"
                      Background="#4CC3FF"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Bottom"
                      Visibility="Collapsed" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#EAF6FF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TaskPanelBorderStyle" TargetType="Border">
      <Setter Property="Background" Value="#071A2B" />
      <Setter Property="BorderBrush" Value="#194766" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style x:Key="TaskFilterComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="Height" Value="42" />
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Background" Value="#081B2C" />
      <Setter Property="BorderBrush" Value="#315873" />
      <Setter Property="Foreground" Value="#E8F2FA" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="12,7" />
    </Style>

    <Style x:Key="TaskDataGridStyle" TargetType="DataGrid">
      <Setter Property="Background" Value="#071A2B" />
      <Setter Property="Foreground" Value="#D7E6F2" />
      <Setter Property="RowBackground" Value="#071A2B" />
      <Setter Property="AlternatingRowBackground" Value="#081D30" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="RowHeight" Value="46" />
      <Setter Property="ColumnHeaderHeight" Value="50" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="#173D57" />
      <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="SelectionMode" Value="Single" />
      <Setter Property="SelectionUnit" Value="FullRow" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="TaskDataGridHeaderStyle" TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#102A40" />
      <Setter Property="Foreground" Value="#DCEAF5" />
      <Setter Property="BorderBrush" Value="#194766" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="TaskDataGridCellStyle" TargetType="DataGridCell">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#D7E6F2" />
      <Setter Property="BorderBrush" Value="#173D57" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="Foreground" Value="#F4FAFF" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="TaskFirstDataGridCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource TaskDataGridCellStyle}">
      <Setter Property="BorderThickness" Value="4,0,0,1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="8,0,10,0" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="BorderBrush" Value="#18C6F4" />
          <Setter Property="Background" Value="Transparent" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="TaskDataGridRowStyle" TargetType="DataGridRow">
      <Setter Property="Background" Value="#071A2B" />
      <Setter Property="Foreground" Value="#D7E6F2" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Style.Triggers>
        <Trigger Property="AlternationIndex" Value="1">
          <Setter Property="Background" Value="#081D30" />
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#0D2A43" />
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#113554" />
          <Setter Property="Foreground" Value="#FFFFFF" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="TaskDataGridTextStyle" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="10,0" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="TaskDataGridCenterTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource TaskDataGridTextStyle}">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style x:Key="TaskDataGridCenterHeaderStyle"
           TargetType="DataGridColumnHeader"
           BasedOn="{StaticResource TaskDataGridHeaderStyle}">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="TaskDataGridRightTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource TaskDataGridTextStyle}">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>

    <Style x:Key="TaskDataGridInsetTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource TaskDataGridTextStyle}">
      <Setter Property="Margin" Value="10,0,0,0" />
    </Style>

    <Style x:Key="TaskDataGridRightHeaderStyle"
           TargetType="DataGridColumnHeader"
           BasedOn="{StaticResource TaskDataGridHeaderStyle}">
      <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>

    <Style x:Key="TaskProgressBarStyle" TargetType="ProgressBar">
      <Setter Property="Height" Value="4" />
      <Setter Property="Background" Value="#2B465B" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid SnapsToDevicePixels="True">
              <Border x:Name="PART_Track"
                      Background="{TemplateBinding Background}"
                      CornerRadius="2" />
              <Border x:Name="PART_Indicator"
                      HorizontalAlignment="Left"
                      Background="{TemplateBinding Foreground}"
                      CornerRadius="2" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TaskPagerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="34" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="MinWidth" Value="38" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="#0A1D2F" />
      <Setter Property="Foreground" Value="#D7E6F2" />
      <Setter Property="BorderBrush" Value="#315873" />
      <Setter Property="BorderThickness" Value="1" />
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.62" />
          <Setter Property="Background" Value="#081A2A" />
          <Setter Property="BorderBrush" Value="#23445C" />
          <Setter Property="Foreground" Value="#698397" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="TaskPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Height" Value="52" />
      <Setter Property="MinHeight" Value="52" />
      <Setter Property="Background" Value="#1D83E2" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#2F95FF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="Bold" />
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Background" Value="#18334A" />
          <Setter Property="BorderBrush" Value="#29485F" />
          <Setter Property="Foreground" Value="#70899D" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource TaskPanelBorderStyle}"
            Padding="14,8"
            Margin="0,0,0,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ItemsControl ItemsSource="{Binding StatisticsTabs}"
                      VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource DataCenterTabButtonStyle}"
                      Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}"
                      Margin="0,0,14,0">
                <Grid>
                  <StackPanel Orientation="Horizontal"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                    <TextBlock Text="{Binding Code}"
                               Foreground="#7F92A6"
                               Opacity="0.45"
                               FontWeight="SemiBold"
                               Margin="0,0,8,0" />
                    <TextBlock x:Name="TabText"
                               Text="{Binding Label}"
                               Foreground="#7F92A6"
                               FontWeight="SemiBold" />
                  </StackPanel>
                  <Border x:Name="TabLine"
                          Height="3"
                          Width="78"
                          CornerRadius="2"
                          Background="#4CC3FF"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Bottom"
                          Margin="0,0,0,-10"
                          Visibility="Collapsed" />
                </Grid>
              </Button>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                  <Setter TargetName="TabText" Property="Foreground" Value="#FFFFFF" />
                  <Setter TargetName="TabText" Property="FontWeight" Value="Bold" />
                  <Setter TargetName="TabLine" Property="Visibility" Value="Visible" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
          <TextBlock Text="海鲜产品"
                     Foreground="#B9CDDC"
                     FontSize="13"
                     VerticalAlignment="Center"
                     Margin="0,0,10,0" />
          <ComboBox ItemsSource="{Binding ProductRows}"
                    SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                    DisplayMemberPath="ProductName"
                    Style="{StaticResource TaskFilterComboBoxStyle}"
                    Width="155"
                    Margin="0,0,18,0" />

          <StackPanel Orientation="Horizontal"
                      Visibility="{Binding IsTaskTabSelected, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="任务类型"
                       Foreground="#B9CDDC"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0" />
            <ComboBox ItemsSource="{Binding TaskTypeOptions}"
                      SelectedItem="{Binding SelectedTaskType, Mode=TwoWay}"
                      DisplayMemberPath="Label"
                      Style="{StaticResource TaskFilterComboBoxStyle}"
                      Width="176"
                       Margin="0,0,18,0" />
          </StackPanel>

          <TextBlock Text="统计范围"
                     Foreground="#B9CDDC"
                     FontSize="13"
                     VerticalAlignment="Center"
                     Margin="0,0,10,0"
                     Visibility="{Binding IsHistoryTabSelected, Converter={StaticResource BoolToVisibilityConverter}}" />

          <ItemsControl ItemsSource="{Binding RangeOptions}"
                        VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding Label}"
                        Style="{StaticResource RangeSegmentButtonStyle}"
                        Command="{Binding DataContext.SelectRangeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Margin="0,0,6,0" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid Background="#061421"
            Visibility="{Binding IsHistoryTabSelected, Converter={StaticResource BoolToVisibilityConverter}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="164" />
          <RowDefinition Height="12" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource HistoryPanelBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#5F7E94" BorderThickness="0,0,1,0" Margin="0,28">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="检测总量" Style="{StaticResource HistoryKpiLabelStyle}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                  <TextBlock Text="{Binding SelectedProduct.TotalCount, TargetNullValue=0}"
                             Style="{StaticResource HistoryKpiValueStyle}" />
                  <TextBlock Text="个" Foreground="#C5D7E6" FontSize="16" Margin="10,13,0,0" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Grid.Column="1" BorderBrush="#5F7E94" BorderThickness="0,0,1,0" Margin="0,28">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="正常" Style="{StaticResource HistoryKpiLabelStyle}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                  <TextBlock Text="{Binding SelectedProduct.NormalCount, TargetNullValue=0}"
                             Style="{StaticResource HistoryKpiValueStyle}"
                             Foreground="#22C98A" />
                  <TextBlock Text="个" Foreground="#C5D7E6" FontSize="16" Margin="10,13,0,0" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Grid.Column="2" BorderBrush="#5F7E94" BorderThickness="0,0,1,0" Margin="0,28">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="异常" Style="{StaticResource HistoryKpiLabelStyle}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                  <TextBlock Text="{Binding SelectedProduct.RejectCount, TargetNullValue=0}"
                             Style="{StaticResource HistoryKpiValueStyle}"
                             Foreground="#FF6268" />
                  <TextBlock Text="个" Foreground="#C5D7E6" FontSize="16" Margin="10,13,0,0" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Grid.Column="3" BorderBrush="#5F7E94" BorderThickness="0,0,1,0" Margin="0,28">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="良率" Style="{StaticResource HistoryKpiLabelStyle}" />
                <TextBlock Text="{Binding SelectedProduct.YieldRate, TargetNullValue=0%}"
                           Style="{StaticResource HistoryKpiValueStyle}"
                           Foreground="#FFC247"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0" />
              </StackPanel>
            </Border>

            <StackPanel Grid.Column="4" VerticalAlignment="Center">
              <TextBlock Text="检测任务" Style="{StaticResource HistoryKpiLabelStyle}" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <TextBlock Text="{Binding YieldTrendItems.Count}"
                           Style="{StaticResource HistoryKpiValueStyle}"
                           Foreground="#409BFF" />
                <TextBlock Text="轮" Foreground="#C5D7E6" FontSize="16" Margin="10,13,0,0" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.2*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0"
                  Style="{StaticResource HistoryPanelBorderStyle}"
                  Padding="24,14">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <TextBlock Text="良率趋势"
                         Foreground="#F4FAFF"
                         FontSize="22"
                         FontWeight="Bold" />
              <TextBlock Grid.Row="1"
                         Text="{Binding YieldTrendSummary}"
                         Foreground="#C2D3E0"
                         FontSize="15"
                         Margin="0,4,0,0" />

              <Viewbox Grid.Row="2"
                       Stretch="Fill"
                       StretchDirection="Both"
                       Margin="0,12,0,0">
                <Canvas Width="1100" Height="450">
                  <Rectangle Canvas.Left="62"
                             Canvas.Top="18"
                             Width="998"
                             Height="75"
                             Fill="#0E22C98A" />
                  <Rectangle Canvas.Left="62"
                             Canvas.Top="93"
                             Width="998"
                             Height="112"
                             Fill="#0BFFC247" />
                  <Rectangle Canvas.Left="62"
                             Canvas.Top="205"
                             Width="998"
                             Height="187"
                             Fill="#0BFF6268" />

                  <TextBlock Canvas.Left="2" Canvas.Top="5" Text="100%" Foreground="#BFD0DE" FontSize="14" />
                  <TextBlock Canvas.Left="18" Canvas.Top="192" Text="50%" Foreground="#BFD0DE" FontSize="14" />
                  <TextBlock Canvas.Left="27" Canvas.Top="379" Text="0%" Foreground="#BFD0DE" FontSize="14" />

                  <Line X1="62" Y1="18" X2="1060" Y2="18" Stroke="#45647C" StrokeThickness="1" Opacity="0.72" />
                  <Line X1="62" Y1="205" X2="1060" Y2="205" Stroke="#45647C" StrokeThickness="1" Opacity="0.72" />
                  <Line X1="62" Y1="392" X2="1060" Y2="392" Stroke="#45647C" StrokeThickness="1" Opacity="0.72" />
                  <Line X1="62" Y1="93" X2="1060" Y2="93"
                        Stroke="#9EB3C5"
                        StrokeThickness="1"
                        StrokeDashArray="6,5" />
                  <TextBlock Canvas.Left="942" Canvas.Top="66"
                             Text="达标线 80%"
                             Foreground="#CFDCE6"
                             FontSize="14" />

                  <Path Data="{Binding YieldTrendQualifiedLineGeometry}"
                        Stroke="#409BFF"
                        StrokeThickness="2.5"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round" />
                  <Path Data="{Binding YieldTrendAlertLineGeometry}"
                        Stroke="#FF6268"
                        StrokeThickness="3.2"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round" />

                  <ItemsControl Width="1100" Height="450" ItemsSource="{Binding YieldTrendItems}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Canvas />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Canvas Width="1100" Height="450">
                          <Path Data="{Binding HitGeometry}"
                                Fill="Transparent"
                                Cursor="Hand"
                                ToolTip="{Binding Summary}">
                            <Path.InputBindings>
                              <MouseBinding MouseAction="LeftClick"
                                            Command="{Binding DataContext.SelectTrendPointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                            </Path.InputBindings>
                          </Path>
                          <Path Data="{Binding MarkerGeometry}"
                                Fill="{Binding MarkerFill}"
                                Stroke="{Binding MarkerStroke}"
                                StrokeThickness="2"
                                IsHitTestVisible="False" />
                        </Canvas>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <ItemsControl Width="1100" Height="450" ItemsSource="{Binding YieldTrendAxisLabels}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Canvas />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                      <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                        <Setter Property="Canvas.Top" Value="414" />
                      </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Label}"
                                   Foreground="#C4D4E1"
                                   FontSize="14"
                                   FontFamily="Segoe UI">
                          <TextBlock.RenderTransform>
                            <TranslateTransform X="-34" />
                          </TextBlock.RenderTransform>
                        </TextBlock>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Canvas>
              </Viewbox>
            </Grid>
          </Border>

          <Border Grid.Column="2"
                  Style="{StaticResource HistoryPanelBorderStyle}"
                  Padding="24,14">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <TextBlock Text="缺陷数量排行"
                         Foreground="#F4FAFF"
                         FontSize="22"
                         FontWeight="Bold" />
              <TextBlock Grid.Row="1"
                         Text="{Binding SelectedProduct.RejectCount, StringFormat=异常总数 {0}, TargetNullValue=异常总数 0}"
                         Foreground="#C2D3E0"
                         FontSize="15"
                         Margin="0,4,0,0" />

              <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="76" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="64" />
                  <ColumnDefinition Width="64" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="缺陷类型" Foreground="#BFD0DE" FontSize="15" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="数量" Foreground="#BFD0DE" FontSize="15" TextAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="占比" Foreground="#BFD0DE" FontSize="15" TextAlignment="Center" VerticalAlignment="Center" />
                <Border Grid.ColumnSpan="4" Height="1" Background="#5F7E94" VerticalAlignment="Bottom" />
              </Grid>

              <ScrollViewer Grid.Row="3"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            Margin="0,8,0,0">
                <ItemsControl ItemsSource="{Binding ProductChartItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Height="56" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="76" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="64" />
                          <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}"
                                   Foreground="#F4FAFF"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="1"
                                     Margin="12,0"
                                     Maximum="100"
                                     Value="{Binding Percent}"
                                     Foreground="#FF6268"
                                     VerticalAlignment="Center"
                                     Style="{StaticResource HistoryDefectProgressStyle}" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding CountText}"
                                   Foreground="#F4FAFF"
                                   FontSize="18"
                                   FontFamily="Consolas"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3"
                                   Text="{Binding PercentText}"
                                   Foreground="#F4FAFF"
                                   FontSize="18"
                                   FontFamily="Consolas"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <TextBlock Grid.Row="3"
                         Text="当前范围内暂无缺陷数据"
                         Foreground="#7897AE"
                         FontSize="15"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ProductChartItems.Count}" Value="0">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <Grid Background="#061421"
            Visibility="{Binding IsTaskTabSelected, Converter={StaticResource BoolToVisibilityConverter}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2.95*" />
          <ColumnDefinition Width="1.15*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource TaskPanelBorderStyle}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="64" />
              <RowDefinition Height="*" />
              <RowDefinition Height="62" />
            </Grid.RowDefinitions>

            <Border BorderBrush="#194766" BorderThickness="0,0,0,1" Padding="16,0">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="检测任务记录"
                           Foreground="#F4FAFF"
                           FontSize="21"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding TaskTotalCount, StringFormat=共 {0} 条}"
                           Foreground="#A9C2D5"
                           FontSize="14"
                           Margin="18,2,0,0"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Border>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding TaskPageRows}"
                      SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                      Style="{StaticResource TaskDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource TaskDataGridHeaderStyle}"
                      CellStyle="{StaticResource TaskDataGridCellStyle}"
                      RowStyle="{StaticResource TaskDataGridRowStyle}"
                      AlternationCount="2"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserResizeRows="False"
                      CanUserSortColumns="False"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
              <DataGrid.Columns>
                <DataGridTextColumn Header="任务编号"
                                    Binding="{Binding SessionCode}"
                                    Width="185"
                                    CellStyle="{StaticResource TaskFirstDataGridCellStyle}"
                                    ElementStyle="{StaticResource TaskDataGridTextStyle}" />
                <DataGridTextColumn Header="任务类型" Binding="{Binding TaskType}" Width="100"
                                    ElementStyle="{StaticResource TaskDataGridInsetTextStyle}" />
                <DataGridTextColumn Header="模型" Binding="{Binding ModelVersion}" Width="100"
                                    ElementStyle="{StaticResource TaskDataGridInsetTextStyle}" />
                <DataGridTextColumn Header="检测总量" Binding="{Binding TotalCount}" Width="120"
                                    HeaderStyle="{StaticResource TaskDataGridRightHeaderStyle}"
                                    ElementStyle="{StaticResource TaskDataGridRightTextStyle}" />
                <DataGridTextColumn Header="正常" Binding="{Binding NormalCount}" Width="90"
                                    HeaderStyle="{StaticResource TaskDataGridRightHeaderStyle}"
                                    ElementStyle="{StaticResource TaskDataGridRightTextStyle}" />
                <DataGridTextColumn Header="异常" Binding="{Binding RejectCount}" Width="90"
                                    HeaderStyle="{StaticResource TaskDataGridRightHeaderStyle}"
                                    ElementStyle="{StaticResource TaskDataGridRightTextStyle}" />
                <DataGridTextColumn Header="良率" Binding="{Binding YieldRate}" Width="90"
                                    HeaderStyle="{StaticResource TaskDataGridRightHeaderStyle}"
                                    ElementStyle="{StaticResource TaskDataGridRightTextStyle}" />
                <DataGridTextColumn Header="开始时间" Binding="{Binding StartedAt}" Width="136"
                                    ElementStyle="{StaticResource TaskDataGridInsetTextStyle}" />
                <DataGridTemplateColumn Header="状态" Width="94"
                                        HeaderStyle="{StaticResource TaskDataGridCenterHeaderStyle}">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="{Binding StatusDotColor}"
                                 Margin="0,0,7,0" />
                        <TextBlock Text="{Binding Status}"
                                   Foreground="#C7D8E5"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="复核进度" Width="*" MinWidth="160">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                       <Grid Margin="10,0" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding ReviewProgressText}"
                                   Foreground="#DCEAF5"
                                   FontSize="13" />
                        <ProgressBar Grid.Row="1"
                                     Style="{StaticResource TaskProgressBarStyle}"
                                     Maximum="100"
                                     Value="{Binding ReviewProgressPercent, Mode=OneWay}"
                                     Foreground="{Binding ReviewProgressColor}"
                                     Margin="0,5,0,0" />
                      </Grid>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="2"
                    BorderBrush="#194766"
                    BorderThickness="0,1,0,0"
                    Padding="16,6,24,6">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TaskTotalText}"
                           Foreground="#A9C2D5"
                           FontSize="14"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                  <Button Style="{StaticResource UnifiedPagerButtonStyle}"
                          Command="{Binding PreviousTaskPageCommand}"
                          IsEnabled="{Binding CanGoToPreviousTaskPage}"
                          Content="‹" ToolTip="上一页" />
                  <TextBlock Text="{Binding TaskPageText}"
                              Foreground="#DCEAF5"
                              FontSize="14"
                              MinWidth="64"
                              TextAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="8,0" />
                  <Button Style="{StaticResource UnifiedPagerButtonStyle}"
                          Command="{Binding NextTaskPageCommand}"
                          IsEnabled="{Binding CanGoToNextTaskPage}"
                          Content="›" ToolTip="下一页" />
                  <TextBlock Text="每页"
                              Foreground="#9FB6C8"
                              FontSize="13"
                              VerticalAlignment="Center"
                              Margin="20,0,8,0" />
                  <ComboBox ItemsSource="{Binding TaskPageSizeOptions}"
                             SelectedItem="{Binding SelectedTaskPageSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Width="78"
                            Height="34"
                            MinHeight="34"
                            Padding="8,4"
                            FontSize="13"
                            Background="#0A1D2F"
                            BorderBrush="#315873" />
                  <TextBlock Text="条"
                              Foreground="#9FB6C8"
                              FontSize="13"
                              VerticalAlignment="Center"
                              Margin="8,0,0,0" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>

        <Border Grid.Column="1"
                Style="{StaticResource TaskPanelBorderStyle}"
                Margin="8,0,0,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border BorderBrush="#194766" BorderThickness="0,0,0,1" Padding="20,18,20,16">
              <StackPanel>
                <TextBlock Text="任务详情"
                           Foreground="#F4FAFF"
                           FontSize="20"
                           FontWeight="Bold" />
                <TextBlock Text="{Binding SelectedSession.SessionCode}"
                           Foreground="#2F95FF"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,7,0,15"
                           TextTrimming="CharacterEllipsis" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                  </Grid.RowDefinitions>

                  <TextBlock Text="检测方式" Foreground="#8FA8BA" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding SelectedSession.TaskType}" Foreground="#DCEAF5" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="1" Text="产品" Foreground="#8FA8BA" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedSession.ProductName}" Foreground="#DCEAF5" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="2" Text="模型" Foreground="#8FA8BA" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedSession.ModelVersion}" Foreground="#DCEAF5" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="3" Text="开始时间" Foreground="#8FA8BA" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedSession.StartedAtFull}" Foreground="#DCEAF5" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="4" Text="结束时间" Foreground="#8FA8BA" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedSession.EndedAtFull}" Foreground="#DCEAF5" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="5" Text="状态" Foreground="#8FA8BA" VerticalAlignment="Center" />
                  <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{Binding SelectedSession.StatusDotColor}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding SelectedSession.Status}" Foreground="#DCEAF5" VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Background="#0A2033"
                    BorderBrush="#194766"
                    BorderThickness="0,0,0,1"
                    Padding="12,14">
              <UniformGrid Columns="4">
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock Text="检测总量" Foreground="#8FA8BA" FontSize="13" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding SelectedSession.TotalCount}" Foreground="#2F95FF" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock Text="正常" Foreground="#8FA8BA" FontSize="13" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding SelectedSession.NormalCount}" Foreground="#22C98A" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock Text="异常" Foreground="#8FA8BA" FontSize="13" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding SelectedSession.RejectCount}" Foreground="#FF5D64" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock Text="良率" Foreground="#8FA8BA" FontSize="13" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding SelectedSession.YieldRate}" Foreground="#F5A623" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,7,0,0" />
                </StackPanel>
              </UniformGrid>
            </Border>

            <Grid Grid.Row="2" Margin="20,18,20,12">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBlock Text="异常分布"
                         Foreground="#F4FAFF"
                         FontSize="17"
                         FontWeight="SemiBold" />
              <ScrollViewer Grid.Row="1"
                            Margin="0,12,0,0"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding SessionChartItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Height="36">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="58" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="42" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}"
                                   Foreground="#B8CCDB"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <ProgressBar Grid.Column="1"
                                     Style="{StaticResource TaskProgressBarStyle}"
                                     Height="6"
                                     Maximum="100"
                                     Value="{Binding Percent, Mode=OneWay}"
                                     Foreground="{Binding Color}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,12,0" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding CountText}"
                                   Foreground="#DCEAF5"
                                   FontSize="13"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>

            <Border Grid.Row="3"
                    BorderBrush="#194766"
                    BorderThickness="0,1,0,0"
                    Padding="20,16,20,14">
              <StackPanel>
                <DockPanel>
                  <TextBlock Text="复核进度"
                             Foreground="#F4FAFF"
                             FontSize="16"
                             FontWeight="SemiBold"
                             DockPanel.Dock="Left" />
                  <TextBlock Text="{Binding SelectedSession.ReviewCountText}"
                             Foreground="#DCEAF5"
                             FontSize="14"
                             HorizontalAlignment="Right" />
                </DockPanel>
                <ProgressBar Style="{StaticResource TaskProgressBarStyle}"
                             Height="6"
                             Maximum="100"
                             Value="{Binding SelectedSession.ReviewProgressPercent, Mode=OneWay}"
                             Foreground="{Binding SelectedSession.ReviewProgressColor}"
                             Margin="0,12,0,16" />
                <Button Style="{StaticResource TaskPrimaryButtonStyle}"
                        Command="{Binding OpenManualReviewCommand}"
                        IsEnabled="{Binding CanOpenSelectedManualReview}">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Viewbox Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center">
                      <Grid Width="24" Height="24">
                        <Ellipse Fill="Transparent" Stroke="#FFFFFF" StrokeThickness="1.8" />
                        <Path Data="M6.5,12.2 L10.2,15.4 L17.7,7.8"
                              Fill="Transparent"
                              Stroke="#FFFFFF"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                      </Grid>
                    </Viewbox>
                    <TextBlock Text="{Binding SelectedSession.ReviewActionText}"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <TextBlock Text="仅已停止且存在异常目标的任务可复核"
                           Foreground="#728DA1"
                           FontSize="12"
                           TextAlignment="Center"
                           Margin="0,10,0,0" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <Border Style="{StaticResource StatisticsPanelBorderStyle}"
              Padding="22"
              Visibility="{Binding IsReportTabSelected, Converter={StaticResource BoolToVisibilityConverter}}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock Text="报表与追溯"
                     Foreground="#FFFFFF"
                     FontSize="24"
                     FontWeight="Bold"
                     HorizontalAlignment="Center" />
          <TextBlock Text="下一版接入报表导出、异常追溯与 X 光影像联动查看。"
                     Foreground="#AFC4D6"
                     FontSize="16"
                     Margin="0,12,0,0"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
