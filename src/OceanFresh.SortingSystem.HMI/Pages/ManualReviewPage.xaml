<UserControl x:Class="OceanFresh.SortingSystem.HMI.Pages.ManualReviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="820"
             d:DesignWidth="1320"
             FontFamily="Noto Sans SC, Microsoft YaHei UI">
  <UserControl.Resources>
    <SolidColorBrush x:Key="ReviewPanelBrush" Color="#082137" />

    <Style x:Key="ReviewPanelStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource ReviewPanelBrush}" />
      <Setter Property="BorderBrush" Value="#164869" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="ReviewSectionTitleStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="ReviewMutedTextStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#8FA9C3" />
      <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="FilterChipButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#0A2941" />
      <Setter Property="BorderBrush" Value="#164869" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#EAF4FF" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="108" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#0F3558" />
              </Trigger>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#103D66" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#2E94EE" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SegmentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#092036" />
      <Setter Property="Foreground" Value="#E8F3FF" />
      <Setter Property="BorderBrush" Value="#214C70" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#1A75BF" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#2E96EE" />
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.9" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CandidateListBoxItemStyle" TargetType="ListBoxItem">
      <Setter Property="MinHeight" Value="84" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderThickness="0"
                    Padding="0">
              <ContentPresenter HorizontalAlignment="Stretch"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#0F3558" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryReviewButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#1377E8" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#36A2FF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="Padding" Value="24,10" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
              <Border x:Name="Chrome"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="5">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.82" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FalsePositiveButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#B61F31" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#FF4E55" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="Padding" Value="24,10" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.82" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SaveNextButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryReviewButtonStyle}">
      <Setter Property="Background" Value="#0F6FD8" />
      <Setter Property="BorderBrush" Value="#2596FF" />
      <Setter Property="MinHeight" Value="62" />
      <Setter Property="FontSize" Value="18" />
    </Style>

    <Style x:Key="FigmaChromeButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#092036" />
      <Setter Property="BorderBrush" Value="#2772B0" />
      <Setter Property="Foreground" Value="#E8F3FF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.92" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.78" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Background" Value="#24364A" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#3F5B74" />
                <Setter Property="Foreground" Value="#7F93A7" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FigmaModeButtonStyle" TargetType="Button" BasedOn="{StaticResource FigmaChromeButtonStyle}">
      <Setter Property="Background" Value="#1263AE" />
      <Setter Property="BorderBrush" Value="#328EE8" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style x:Key="CorrectionOptionButtonStyle" TargetType="Button" BasedOn="{StaticResource FigmaChromeButtonStyle}">
      <Setter Property="Background" Value="#092036" />
      <Setter Property="BorderBrush" Value="#2094F3" />
      <Setter Property="Foreground" Value="#E8F3FF" />
      <Setter Property="Padding" Value="12,6" />
    </Style>
  </UserControl.Resources>

  <Border Background="#061D31"
          BorderBrush="#164B70"
          BorderThickness="1"
          CornerRadius="6"
          Padding="16,10,30,20"
          SnapsToDevicePixels="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="102" />
      <RowDefinition Height="618" />
      <RowDefinition Height="92" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="46" />
          <RowDefinition Height="56" />
        </Grid.RowDefinitions>

        <TextBlock Text="人工复核工作台"
                   Foreground="#F3F8FC"
                   FontSize="30"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="12,0,0,0" />

        <Border Grid.Row="1"
                Background="#071D31"
                BorderBrush="#185072"
                BorderThickness="1"
                CornerRadius="5"
                Padding="18,8"
                Margin="0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding SessionTitle}"
                       Foreground="#2F95FF"
                       FontSize="22"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,28,0" />
            <TextBlock Grid.Column="1"
                       Text="{Binding SessionSubtitle}"
                      Foreground="#C9D9E8"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Margin="0,0,26,0" />
            <TextBlock Grid.Column="2"
                       Text="{Binding CandidateCount, StringFormat=异常 {0}}"
                       Foreground="#FF5D5D"
                       FontSize="19"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,24,0" />
            <TextBlock Grid.Column="3"
                       Text="{Binding ReviewedCount, StringFormat=已复核 {0}}"
                       Foreground="#10D7A7"
                       FontSize="19"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,24,0" />
            <TextBlock Grid.Column="4"
                       Text="{Binding RemainingCount, StringFormat=剩余 {0}}"
                       Foreground="#F59E0B"
                       FontSize="19"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,28,0" />

            <Grid Grid.Column="5" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="复核进度"
                         Foreground="#9CB7CB"
                         FontSize="13"
                         Margin="0,0,10,0"
                         VerticalAlignment="Center" />
              <ProgressBar Grid.Column="1"
                           Height="12"
                           Minimum="0"
                           Maximum="100"
                           Value="{Binding CompletionPercent, Mode=OneWay}"
                           Foreground="#4BA3FF"
                           Background="#23445F"
                           BorderThickness="0" />
              <TextBlock Grid.Column="2"
                         Text="{Binding CompletionText}"
                         Foreground="#2F95FF"
                         FontSize="24"
                         FontWeight="Bold"
                         Margin="12,0,0,0"
                         VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Column="6"
                    Background="#063D36"
                    BorderBrush="#128A70"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="16,8"
                    Margin="24,0,0,0">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="14" Height="14" Fill="#10D7A7" Margin="0,0,10,0" />
                <TextBlock Text="复核进行中"
                           Foreground="#10D7A7"
                           FontSize="17"
                           FontWeight="Bold" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Grid Grid.Row="1" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="274" />
        <ColumnDefinition Width="386" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource ReviewPanelStyle}"
              Padding="14"
              Margin="0,0,10,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,14">
            <TextBlock Text="缺陷类型"
                       Style="{StaticResource ReviewSectionTitleStyle}" />
            <TextBlock Text="只显示对应异常对象"
                       Style="{StaticResource ReviewMutedTextStyle}"
                       Margin="0,6,0,0" />
          </StackPanel>

          <ItemsControl Grid.Row="1" ItemsSource="{Binding DefectFilters}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Command="{Binding DataContext.SelectDefectFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource FilterChipButtonStyle}"
                        Width="220"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,12">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="6" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{Binding AccentColor}"
                            CornerRadius="4,0,0,4"
                            Opacity="0.95" />
                    <Grid Grid.Column="1" Margin="16,12">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <DockPanel>
                        <TextBlock Text="{Binding Count}"
                                   DockPanel.Dock="Right"
                                   Foreground="#FFFFFF"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Label}"
                                   Foreground="#FFFFFF"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                      </DockPanel>
                      <Grid Grid.Row="1"
                            Height="6"
                            Margin="0,12,0,0"
                            Width="174"
                            HorizontalAlignment="Left">
                        <Border Background="#294A63" CornerRadius="3" />
                        <Border Width="{Binding ProgressWidth}"
                                Background="{Binding AccentColor}"
                                CornerRadius="3"
                                HorizontalAlignment="Left" />
                      </Grid>
                      <DockPanel Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock Text="{Binding ProgressPercentText}"
                                   DockPanel.Dock="Right"
                                   Foreground="#AFC7DA"
                                   FontSize="13" />
                        <TextBlock Text="{Binding ReviewedText}"
                                   Foreground="#AFC7DA"
                                   FontSize="13" />
                      </DockPanel>
                    </Grid>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>

      <Border Grid.Column="1"
              Style="{StaticResource ReviewPanelStyle}"
              Padding="16"
              Margin="0,0,10,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <DockPanel Margin="0,0,0,12">
            <TextBlock Text="待复核对象"
                       Style="{StaticResource ReviewSectionTitleStyle}"
                       DockPanel.Dock="Left" />
            <TextBlock Text="{Binding FilteredCandidates.Count, StringFormat=共 {0} 项}"
                       Foreground="#9FC8FF"
                       FontSize="14"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
          </DockPanel>

          <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Background="#061724"
                    BorderBrush="#194B70"
                    BorderThickness="1"
                    CornerRadius="4"
                    Height="40"
                    Padding="12,0">
              <Grid>
                <TextBlock Text="&#xE721;"
                           FontFamily="Segoe MDL2 Assets"
                           Foreground="#8EA8BD"
                           FontSize="16"
                           VerticalAlignment="Center" />
                <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="16"
                         Padding="28,0,0,0"
                         VerticalContentAlignment="Center" />
              </Grid>
            </Border>

            <ItemsControl Grid.Row="1"
                          ItemsSource="{Binding ReviewStatusFilters}"
                          Margin="0,10,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Content="{Binding DisplayText}"
                          Command="{Binding DataContext.SelectReviewStatusFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}"
                          Style="{StaticResource SegmentButtonStyle}"
                          Margin="0,0,6,0" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>

          <ListBox Grid.Row="2"
                   ItemsSource="{Binding FilteredCandidates}"
                   SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}"
                   Background="#061724"
                   BorderBrush="#173E5C"
                   BorderThickness="1"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.CanContentScroll="True"
                   VirtualizingPanel.IsVirtualizing="True"
                   VirtualizingPanel.VirtualizationMode="Recycling"
                   ItemContainerStyle="{StaticResource CandidateListBoxItemStyle}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border x:Name="CandidateCard"
                        Height="84"
                        Padding="12"
                        Margin="4,4,4,26"
                        Background="#082137"
                        BorderBrush="#173E5C"
                        BorderThickness="1"
                        CornerRadius="5">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="70" />
                      <ColumnDefinition Width="14" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="22" />
                    </Grid.ColumnDefinitions>

                    <Border Width="70"
                            Height="58"
                            Background="#E8EDF1"
                            CornerRadius="2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            ClipToBounds="True">
                      <Grid ClipToBounds="True">
                        <Image Source="{Binding ReviewImagePath}"
                               Stretch="UniformToFill"
                               Opacity="0.82" />
                      </Grid>
                    </Border>

                    <Grid Grid.Column="2" VerticalAlignment="Center">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="24" />
                        <RowDefinition Height="24" />
                      </Grid.RowDefinitions>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ImageName}"
                                   Foreground="#EAF4FF"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Width="92"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <Border Background="#5A121B"
                                BorderBrush="#DF3B42"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,2"
                                Margin="4,0,0,0">
                          <TextBlock Foreground="#FF6969"
                                     FontSize="12"
                                     FontWeight="Bold">
                            <Run Text="{Binding ModelLabel}" />
                            <Run Text=" " />
                            <Run Text="{Binding Confidence}" />
                          </TextBlock>
                        </Border>
                      </StackPanel>
                      <TextBlock Grid.Row="1"
                                 Text="{Binding CapturedAt, StringFormat=检测时间： {0}}"
                                 Foreground="#7892AA"
                                 FontSize="12"
                                 VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Column="3"
                          Width="18"
                          Height="18"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center">
                      <Ellipse x:Name="RadioRing"
                               Stroke="#668CA9"
                               StrokeThickness="2"
                               Fill="Transparent" />
                      <Ellipse x:Name="RadioDot"
                               Width="18"
                               Height="18"
                               Fill="#2F95FF"
                               Visibility="Collapsed" />
                    </Grid>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="CandidateCard" Property="Background" Value="#0F3558" />
                    <Setter TargetName="CandidateCard" Property="BorderBrush" Value="#2094F3" />
                    <Setter TargetName="RadioRing" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="RadioDot" Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Border Grid.Row="3"
                  Background="#061724"
                  BorderBrush="#153A55"
                  BorderThickness="1,0,0,0"
                  Padding="12,10"
                  Margin="0,10,0,0">
            <TextBlock Text="选择对象后，右侧才生成单目标复核图，避免列表加载卡顿。"
                       Foreground="#8EA8BD"
                       FontSize="13" />
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="2"
              Style="{StaticResource ReviewPanelStyle}"
              Padding="20,14,20,16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Height="60">
            <DockPanel Height="34" LastChildFill="False">
              <TextBlock Text="单目标预览与判定"
                         Style="{StaticResource ReviewSectionTitleStyle}"
                         DockPanel.Dock="Left" />
              <Border Background="#0B2437"
                      BorderBrush="#315878"
                      BorderThickness="1"
                      CornerRadius="4"
                      Width="78"
                      Height="32"
                      Padding="0"
                      DockPanel.Dock="Right"
                      HorizontalAlignment="Right">
                <TextBlock Text="{Binding RemainingCount, StringFormat=剩余 {0} 个}"
                           Foreground="#F59E0B"
                           FontSize="14"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
            </DockPanel>
            <TextBlock Text="{Binding SummaryText}"
                       Foreground="#8FA9C3"
                       FontSize="14"
                       Margin="0,1,0,0"
                       TextWrapping="Wrap" />
          </StackPanel>

          <Border Grid.Row="1"
                  Background="#061724"
                  BorderBrush="#173E5C"
                  BorderThickness="1"
                  CornerRadius="4"
                  Height="266"
                  Margin="0,10,0,14"
                  Padding="12,12,14,8"
                  VerticalAlignment="Top">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="466" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="320" />
              </Grid.ColumnDefinitions>

              <Grid Width="466"
                    Height="246"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ClipToBounds="True">
                <Viewbox Stretch="Uniform"
                         StretchDirection="DownOnly"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                  <Border Background="#ECEFF2"
                          BorderBrush="#D5DDE4"
                          BorderThickness="1"
                          CornerRadius="3"
                          ClipToBounds="True">
                    <Grid>
                      <Image Source="{Binding PreviewImagePath}"
                             Stretch="None"
                             RenderOptions.BitmapScalingMode="HighQuality" />
                      <Border Background="#159A64"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Padding="8,3"
                              Margin="10">
                        <TextBlock Text="正常"
                                   Foreground="#FFFFFF"
                                   FontSize="12"
                                   FontWeight="Bold" />
                      </Border>
                      <Border Background="#D8333A"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Padding="8,3"
                              Margin="10">
                        <TextBlock Foreground="#FFFFFF"
                                   FontSize="12"
                                   FontWeight="Bold">
                          <Run Text="{Binding SelectedCandidate.ModelLabel}" />
                          <Run Text=" " />
                          <Run Text="{Binding SelectedCandidate.Confidence}" />
                        </TextBlock>
                      </Border>
                    </Grid>
                  </Border>
                </Viewbox>
              </Grid>

              <Border Grid.Column="2"
                      Background="#071F33"
                      BorderBrush="#173E5C"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="14">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="94" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <TextBlock Text="图片编号" Foreground="#9CB7CB" FontSize="13" />
                  <TextBlock Grid.Column="1" Text="{Binding SelectedCandidate.ImageName}" Foreground="#EAF4FF" FontSize="13" />

                  <TextBlock Grid.Row="1" Text="模型判定" Foreground="#9CB7CB" FontSize="13" Margin="0,16,0,0" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedCandidate.ModelLabel}" Foreground="#EAF4FF" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,0" />

                  <TextBlock Grid.Row="2" Text="检测置信度" Foreground="#9CB7CB" FontSize="13" Margin="0,16,0,0" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedCandidate.Confidence}" Foreground="#EAF4FF" FontSize="13" Margin="0,16,0,0" />

                  <TextBlock Grid.Row="3" Text="目标框" Foreground="#9CB7CB" FontSize="13" Margin="0,16,0,0" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedCandidate.Box}" Foreground="#EAF4FF" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,16,0,0" />

                  <TextBlock Grid.Row="4" Text="人工标签" Foreground="#9CB7CB" FontSize="13" Margin="0,16,0,0" />
                  <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding HumanLabel}" Foreground="#EAF4FF" FontSize="13" Margin="0,16,0,0" />

                  <TextBlock Grid.Row="5" Text="批次" Foreground="#9CB7CB" FontSize="13" Margin="0,16,0,0" />
                  <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SessionTitle}" Foreground="#EAF4FF" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,16,0,0" />
                </Grid>
              </Border>
            </Grid>
          </Border>

          <Grid Grid.Row="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="286" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="268" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="232" />
              </Grid.ColumnDefinitions>
              <Button Style="{StaticResource PrimaryReviewButtonStyle}"
                      Command="{Binding ConfirmSelectedCommand}"
                      Height="56"
                      Margin="0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <TextBlock Text="&#xE930;"
                             FontFamily="Segoe MDL2 Assets"
                             FontSize="27"
                             Margin="0,0,12,0"
                             VerticalAlignment="Center" />
                  <TextBlock Text="确认异常"
                             FontSize="24"
                             FontWeight="Bold"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Grid.Column="2"
                      Style="{StaticResource FalsePositiveButtonStyle}"
                      Command="{Binding MarkFalsePositiveCommand}"
                      Height="56"
                      Margin="0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <TextBlock Text="&#xE711;"
                             FontFamily="Segoe MDL2 Assets"
                             FontSize="25"
                             Margin="0,0,12,0"
                             VerticalAlignment="Center" />
                  <TextBlock Text="正常误检"
                             FontSize="24"
                             FontWeight="Bold"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Border Grid.Column="4"
                      Background="#09243A"
                      BorderBrush="#214C70"
                      BorderThickness="1"
                      CornerRadius="4"
                      Height="56"
                      Padding="14,8">
                <StackPanel>
                  <TextBlock Text="保存后自动进入下一条未复核对象"
                             Foreground="#9CB7CB"
                             FontSize="14" />
                  <TextBlock Text="{Binding StatusMessage}"
                             Foreground="#8BE5BE"
                             FontFamily="Courier New"
                             FontSize="13"
                             Margin="0,6,0,0"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Grid.Row="1"
                    Background="#071F33"
                    BorderBrush="#173E5C"
                    BorderThickness="1"
                    CornerRadius="5"
                    Width="810"
                    Height="156"
                    HorizontalAlignment="Left"
                    Padding="12"
                    Margin="0,12,0,0">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="30" />
                  <RowDefinition Height="26" />
                  <RowDefinition Height="94" />
                </Grid.RowDefinitions>

                <DockPanel>
                  <TextBlock Text="异常类别修正"
                             Foreground="#D2E3F2"
                             FontSize="17"
                             FontWeight="Bold"
                             DockPanel.Dock="Left" />
                  <TextBlock Text="确认异常后可修正类别，候选项不包含当前模型标签"
                             Foreground="#8EA8BD"
                             FontSize="13"
                             Margin="18,0,0,0"
                             VerticalAlignment="Center" />
                </DockPanel>

                <TextBlock Grid.Row="1"
                           Text="{Binding SelectedModelLabelText}"
                           Foreground="#D2E3F2"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <Grid Grid.Row="2" Margin="0,1,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="310" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="184" />
                  </Grid.ColumnDefinitions>
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="38" />
                      <RowDefinition Height="32" />
                      <RowDefinition Height="32" />
                    </Grid.RowDefinitions>
                    <Border Background="#061724"
                            BorderBrush="#2094F3"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,0">
                      <Grid>
                        <TextBlock Text="{Binding CorrectionDefaultText}"
                                   Foreground="#E8F3FF"
                                   FontSize="15"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,24,0" />
                        <TextBlock Text="∨"
                                   Foreground="#D2E3F2"
                                   FontSize="15"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                    <ItemsControl Grid.Row="1"
                                  Grid.RowSpan="2"
                                  ItemsSource="{Binding CorrectionLabels}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Command="{Binding DataContext.SetHumanLabelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"
                                  Background="#0A2941"
                                  BorderBrush="#164869"
                                  BorderThickness="1"
                                  Foreground="#E8F3FF"
                                  Height="32"
                                  HorizontalContentAlignment="Left"
                                  Padding="14,0"
                                  FontSize="15">
                            <TextBlock Text="{Binding}" />
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                  <Border Grid.Column="2"
                          Background="#061724"
                          BorderBrush="#173E5C"
                          BorderThickness="1"
                          CornerRadius="4"
                          Height="94"
                          Padding="14,0">
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14"
                             VerticalContentAlignment="Top"
                             Margin="0,7,0,0" />
                  </Border>
                  <Button Grid.Column="4"
                          Style="{StaticResource SaveNextButtonStyle}"
                          Command="{Binding SaveReviewCommand}"
                          Height="62"
                          Width="184"
                          VerticalAlignment="Top"
                          FontSize="18">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                      <TextBlock Text="&#xE74E;"
                                 FontFamily="Segoe MDL2 Assets"
                                 FontSize="17"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center" />
                      <TextBlock Text="保存并下一条" FontWeight="Bold" />
                    </StackPanel>
                  </Button>
                </Grid>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2"
            Background="#071D31"
            BorderBrush="#164B70"
            BorderThickness="1"
            CornerRadius="5"
            Padding="14"
            Margin="0,16,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding CompletionGuidanceText}"
                   Foreground="#D2E3F2"
                   FontSize="16"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
        <Border Grid.Column="1"
                Background="#2A2416"
                BorderBrush="#8B6726"
                BorderThickness="1"
                CornerRadius="4"
                Padding="24,10"
                VerticalAlignment="Center"
                Margin="18,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE7BA;"
                       FontFamily="Segoe MDL2 Assets"
                       Foreground="#F59E0B"
                       FontSize="18"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding CompletionGateText}"
                       Foreground="#F59E0B"
                       FontSize="16"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <Button Grid.Column="2"
                Content="完成本次复核"
                IsEnabled="{Binding IsReviewComplete}"
                Command="{Binding BackCommand}"
                Style="{StaticResource FigmaChromeButtonStyle}"
                Height="48"
                MinWidth="160" />
      </Grid>
    </Border>
  </Grid>
  </Border>
</UserControl>
