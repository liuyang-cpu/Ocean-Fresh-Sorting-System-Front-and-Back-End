<UserControl x:Class="OceanFresh.SortingSystem.HMI.Pages.EjectionSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
  <UserControl.Resources>
    <Style x:Key="ParameterTextBoxStyle" TargetType="TextBox">
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="#081D31" />
      <Setter Property="Foreground" Value="#DCEAF5" />
      <Setter Property="BorderBrush" Value="#315873" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="14" />
    </Style>
  </UserControl.Resources>

  <Grid Background="{StaticResource ShellBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="62" />
      <RowDefinition Height="*" />
      <RowDefinition Height="64" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="1.15*" />
      </Grid.ColumnDefinitions>
      <ItemsControl ItemsSource="{Binding MethodOptions}" VerticalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border x:Name="MethodChrome" Height="46" Background="#071B2D" BorderBrush="#315873" BorderThickness="1" Padding="18,0">
              <TextBlock Text="{Binding Name}" Foreground="#DCEAF5" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="MethodChrome" Property="Background" Value="#173F59" />
                <Setter TargetName="MethodChrome" Property="BorderBrush" Value="#4C8DB8" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <TextBlock Text="散料气吹控制" Foreground="#DCEAF5" FontSize="15" VerticalAlignment="Center" Margin="0,0,14,0" />
        <CheckBox IsChecked="{Binding IsAirJetEnabled}" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="1*" />
      </Grid.ColumnDefinitions>

      <Border Background="#071B2D" BorderBrush="#315873" BorderThickness="1" CornerRadius="4">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border BorderBrush="#315873" BorderThickness="0,0,0,1" Padding="20,0">
            <TextBlock Text="控制信息" Foreground="#DCEAF5" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <ItemsControl ItemsSource="{Binding TimingParameters}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="190" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" Foreground="#AFC2D2" FontSize="15" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParameterTextBoxStyle}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <Border Grid.Column="2" Background="#071B2D" BorderBrush="#315873" BorderThickness="1" CornerRadius="4">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border BorderBrush="#315873" BorderThickness="0,0,0,1" Padding="20,0">
            <TextBlock Text="剔除位与行参数" Foreground="#DCEAF5" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <ItemsControl ItemsSource="{Binding LaneParameters}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="190" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" Foreground="#AFC2D2" FontSize="15" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParameterTextBoxStyle}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2" Margin="0,12,0,0">
      <TextBlock Text="{Binding StatusMessage}" Foreground="#8FA9C1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Width="92" Height="40" Margin="0,0,10,0" Background="#071B2D" BorderBrush="#315873" BorderThickness="1" Command="{Binding SendCommand}" Content="发送" />
        <Button Width="108" Height="40" Margin="0,0,10,0" Background="#071B2D" BorderBrush="#315873" BorderThickness="1" Command="{Binding RestoreCommand}" Content="恢复备份" />
        <Button Width="92" Height="40" Background="#3C82AD" BorderBrush="#5F9DC4" BorderThickness="1" Command="{Binding SaveCommand}" Content="保存" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
