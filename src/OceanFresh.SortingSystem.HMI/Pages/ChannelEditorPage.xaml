<UserControl x:Class="OceanFresh.SortingSystem.HMI.Pages.ChannelEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
  <Grid Background="{StaticResource SettingsEditorBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="64" />
      <RowDefinition Height="*" />
      <RowDefinition Height="72" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="24,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0"
              VerticalAlignment="Center"
              Margin="0,0,18,0"
              Style="{StaticResource SettingsEditorReturnButtonStyle}"
              Command="{Binding BackToListCommand}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Viewbox Width="16" Height="16" Margin="0,0,8,0">
            <Path Data="{StaticResource SettingsBackIconGeometry}"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.8"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />
          </Viewbox>
          <TextBlock Text="返回列表" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <TextBlock Grid.Column="1"
                 FontSize="26"
                 FontWeight="SemiBold"
                 Foreground="#EAF4FF"
                 VerticalAlignment="Center">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Text" Value="添加通道" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding CanDelete}" Value="True">
                <Setter Property="Text" Value="编辑通道" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <Border Width="700"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="0,30,0,24"
              Padding="24"
              Style="{StaticResource SettingsEditorCardStyle}">
        <StackPanel>
          <TextBlock Style="{StaticResource SettingsEditorLabelStyle}" Margin="0,0,0,8">
            <Run Text="通道名称" /><Run Text=" *" Foreground="#18B8F2" />
          </TextBlock>
          <Border Style="{StaticResource SettingsEditorInputFrameStyle}" Margin="0,0,0,26">
            <Grid>
              <TextBox x:Name="ChannelNameEditor"
                       Text="{Binding DraftChannelName, UpdateSourceTrigger=PropertyChanged}"
                       Foreground="#EAF4FF"
                       FontSize="15"
                       VerticalContentAlignment="Center" />
              <TextBlock Text="请输入通道名称"
                         IsHitTestVisible="False"
                         Foreground="#6F879C"
                         FontSize="14"
                         VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Text, ElementName=ChannelNameEditor}" Value="">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Text, ElementName=ChannelNameEditor}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </Border>

          <TextBlock Style="{StaticResource SettingsEditorLabelStyle}" Margin="0,0,0,8">
            <Run Text="海鲜产品" /><Run Text=" *" Foreground="#18B8F2" />
          </TextBlock>
          <ComboBox Height="44"
                    MinHeight="44"
                    Margin="0,0,0,26"
                    Padding="14,0"
                    ItemsSource="{Binding ProductOptions}"
                    SelectedValue="{Binding DraftProductId}"
                    SelectedValuePath="Id"
                    DisplayMemberPath="Name"
                    Background="{StaticResource SettingsEditorFieldBrush}"
                    BorderBrush="{StaticResource SettingsEditorBorderBrush}"
                    BorderThickness="1" />

          <TextBlock Style="{StaticResource SettingsEditorLabelStyle}" Margin="0,0,0,8">
            <Run Text="模型" /><Run Text=" *" Foreground="#18B8F2" />
          </TextBlock>
          <ComboBox Height="44"
                    MinHeight="44"
                    Padding="14,0"
                    ItemsSource="{Binding AvailableModelOptions}"
                    SelectedValue="{Binding DraftModelVersionId}"
                    SelectedValuePath="Id"
                    DisplayMemberPath="Version"
                    IsEnabled="{Binding CanSelectModel}"
                    Background="{StaticResource SettingsEditorFieldBrush}"
                    BorderBrush="{StaticResource SettingsEditorBorderBrush}"
                    BorderThickness="1" />
        </StackPanel>
      </Border>
    </ScrollViewer>

    <Border Grid.Row="2"
            Background="#061629"
            BorderBrush="{StaticResource SettingsEditorBorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid Margin="24,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   Text="{Binding StatusMessage}"
                   ToolTip="{Binding StatusMessage}"
                   Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibilityConverter}}"
                   Style="{StaticResource SettingsEditorStatusTextStyle}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Button Style="{StaticResource SettingsEditorPrimaryButtonStyle}"
                Command="{Binding SaveChannelCommand}">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
            <TextBlock Text="保存通道" Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
