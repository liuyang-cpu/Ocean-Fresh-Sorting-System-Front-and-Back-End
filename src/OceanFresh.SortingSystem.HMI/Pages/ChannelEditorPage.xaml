<UserControl x:Class="OceanFresh.SortingSystem.HMI.Pages.ChannelEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Border Background="{StaticResource PanelBackground}" CornerRadius="18" Padding="24">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <DockPanel Margin="0,0,0,18">
            <StackPanel>
              <TextBlock Text="通道编辑" Foreground="{StaticResource TextBrush}" FontSize="24" FontWeight="SemiBold" />
              <TextBlock Text="设置通道名、海鲜产品、模型和运行参数。"
                         Foreground="{StaticResource MutedTextBrush}"
                         Margin="0,8,0,0" />
            </StackPanel>
            <Button DockPanel.Dock="Right"
                    Padding="16,10"
                    MinWidth="120"
                    Background="{StaticResource SurfaceBrush}"
                    Foreground="{StaticResource TextBrush}"
                    BorderThickness="0"
                    HorizontalAlignment="Right"
                    Command="{Binding BackToListCommand}">
              <TextBlock Text="返回通道列表" />
            </Button>
          </DockPanel>

          <Border Background="{StaticResource SurfaceSoftBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,18">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
          </Border>

          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="通道编号" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
              <Border Background="{StaticResource SurfaceSoftBrush}" CornerRadius="12" Padding="14">
                <TextBox Text="{Binding DraftChannelNo, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding IsChannelNoReadOnly}"
                         Foreground="{StaticResource TextBrush}"
                         FontSize="16"
                         Background="Transparent"
                         BorderThickness="0" />
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="通道名称" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
              <Border Background="{StaticResource SurfaceSoftBrush}" CornerRadius="12" Padding="14">
                <TextBox Text="{Binding DraftChannelName, UpdateSourceTrigger=PropertyChanged}"
                         Foreground="{StaticResource TextBrush}"
                         FontSize="16"
                         Background="Transparent"
                         BorderThickness="0" />
              </Border>
            </StackPanel>
          </Grid>

          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="现有海鲜产品" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
              <Border Background="{StaticResource SurfaceSoftBrush}" CornerRadius="12" Padding="10">
                <ComboBox ItemsSource="{Binding ProductOptions}"
                          SelectedValue="{Binding DraftProductId}"
                          SelectedValuePath="Id"
                          DisplayMemberPath="Name"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="{StaticResource TextBrush}" />
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="现有模型" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
              <Border Background="{StaticResource SurfaceSoftBrush}" CornerRadius="12" Padding="10">
                <ComboBox ItemsSource="{Binding AvailableModelOptions}"
                          SelectedValue="{Binding DraftModelVersionId}"
                          SelectedValuePath="Id"
                          DisplayMemberPath="Version"
                          IsEnabled="{Binding CanSelectModel}"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="{StaticResource TextBrush}" />
              </Border>
            </StackPanel>
          </Grid>

          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="缺陷处理方式" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
              <Border Background="{StaticResource SurfaceSoftBrush}" CornerRadius="12" Padding="14">
                <ComboBox SelectedValue="{Binding DraftDefectAction}"
                          SelectedValuePath="Tag"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="{StaticResource TextBrush}">
                  <ComboBoxItem Content="下沉" Tag="Sink" />
                  <ComboBoxItem Content="气吹" Tag="AirJet" />
                  <ComboBoxItem Content="推杆" Tag="Pusher" />
                  <ComboBoxItem Content="停机" Tag="StopLine" />
                </ComboBox>
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
              <TextBlock Text="皮带速度" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
              <Border Background="{StaticResource SurfaceSoftBrush}" CornerRadius="12" Padding="14">
                <TextBox Text="{Binding DraftConveyorSpeed, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding IsConveyorSpeedReadOnly}"
                         Foreground="{StaticResource TextBrush}"
                         FontSize="16"
                         Background="Transparent"
                         BorderThickness="0" />
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,12,0">
              <TextBlock Text="X 光电压" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
              <Border Background="{StaticResource SurfaceSoftBrush}" CornerRadius="12" Padding="14">
                <TextBox Text="{Binding DraftVoltage, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding IsVoltageReadOnly}"
                         Foreground="{StaticResource TextBrush}"
                         FontSize="16"
                         Background="Transparent"
                         BorderThickness="0" />
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="3">
              <TextBlock Text="X 光电流" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
              <Border Background="{StaticResource SurfaceSoftBrush}" CornerRadius="12" Padding="14">
                <TextBox Text="{Binding DraftCurrent, UpdateSourceTrigger=PropertyChanged}"
                         Foreground="{StaticResource TextBrush}"
                         FontSize="16"
                         Background="Transparent"
                         BorderThickness="0" />
              </Border>
            </StackPanel>
          </Grid>

          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="1.3*" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="置信度阈值" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
              <Border Background="{StaticResource SurfaceSoftBrush}" CornerRadius="12" Padding="14">
                <TextBox Text="{Binding DraftConfidenceThreshold, UpdateSourceTrigger=PropertyChanged}"
                         Foreground="{StaticResource TextBrush}"
                         FontSize="16"
                         Background="Transparent"
                         BorderThickness="0" />
              </Border>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource SurfaceSoftBrush}" CornerRadius="16" Padding="18">
              <StackPanel>
                <TextBlock Text="编辑原则" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="通道编号、皮带速度和 X 光电压在创建后锁定；修改通道时只维护合法可变项。"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Grid>

          <StackPanel Orientation="Horizontal">
            <Button Padding="18,12"
                    Background="{StaticResource AccentBrush}"
                    Foreground="#08121B"
                    BorderThickness="0"
                    FontWeight="Bold"
                    MinWidth="96"
                    Command="{Binding SaveChannelCommand}">
              <TextBlock Text="保存通道" />
            </Button>
            <Button Margin="12,0,0,0"
                    Padding="18,12"
                    Background="{StaticResource DangerBrush}"
                    Foreground="{StaticResource TextBrush}"
                    BorderThickness="0"
                    MinWidth="96"
                    Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibilityConverter}}"
                    Command="{Binding DeleteChannelCommand}">
              <TextBlock Text="删除通道" />
            </Button>
            <Button Margin="12,0,0,0"
                    Padding="18,12"
                    Background="{StaticResource SurfaceBrush}"
                    Foreground="{StaticResource TextBrush}"
                    BorderThickness="0"
                    MinWidth="108"
                    Command="{Binding BackToListCommand}">
              <TextBlock Text="取消并返回" />
            </Button>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
