<UserControl x:Class="OceanFresh.SortingSystem.HMI.Pages.RecipesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextHintingMode="Fixed">
  <Border Background="#0B2136"
          BorderBrush="#31465A"
          BorderThickness="1"
          CornerRadius="5"
          Padding="24">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="44" />
        <RowDefinition Height="*" />
        <RowDefinition Height="72" />
      </Grid.RowDefinitions>

      <DockPanel Margin="0,0,0,18" LastChildFill="False">
        <StackPanel>
          <TextBlock Text="海鲜产品" Foreground="#EAF4FF" FontSize="26" FontWeight="SemiBold" />
        </StackPanel>
        <Button DockPanel.Dock="Right"
                Style="{StaticResource SettingsListAddButtonStyle}"
                Command="{Binding OpenCreateProductCommand}">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="＋" FontSize="18" FontWeight="Normal" VerticalAlignment="Center" />
            <TextBlock Text="添加产品" Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </DockPanel>

      <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="440" Style="{StaticResource SettingsListSearchContainerStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="22" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE721;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="15"
                       Foreground="#73A7C7"
                       VerticalAlignment="Center" />
            <TextBox Grid.Column="1"
                     Style="{StaticResource SettingsListSearchTextBoxStyle}"
                     Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="搜索产品名称、编码或缺陷类型" />
          </Grid>
        </Border>
      </StackPanel>

      <DataGrid Grid.Row="2"
                Margin="0,14,0,14"
                Style="{StaticResource SettingsListDataGridStyle}"
                ItemsSource="{Binding VisibleProducts}"
                SelectedItem="{Binding SelectedProduct}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                IsReadOnly="True"
                SelectionUnit="FullRow"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
        <DataGrid.Columns>
          <DataGridTextColumn Header="海鲜名称"
                              Binding="{Binding Name}"
                              Width="1.1*"
                              ElementStyle="{StaticResource SettingsListTextCellStyle}" />
          <DataGridTextColumn Header="产品编码"
                              Binding="{Binding Code}"
                              Width="1*"
                              ElementStyle="{StaticResource SettingsListTextCellStyle}" />
          <DataGridTemplateColumn Header="缺陷类型" Width="2.2*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ItemsControl ItemsSource="{Binding DefectTraits}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Margin="16,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border MinWidth="66"
                              Height="30"
                              Margin="0,0,10,0"
                              Padding="10,0"
                              Background="#0D2942"
                              BorderBrush="#3A6C8B"
                              BorderThickness="1"
                              CornerRadius="3">
                        <TextBlock Text="{Binding}"
                                   Foreground="#D7E8F6"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="操作" Width="180">
            <DataGridTemplateColumn.HeaderStyle>
              <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource SettingsListColumnHeaderStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
              </Style>
            </DataGridTemplateColumn.HeaderStyle>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Button Style="{StaticResource SettingsListActionButtonStyle}"
                          Tag="{StaticResource SettingsPreviewIconGeometry}"
                          Command="{Binding DataContext.OpenProductDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}"
                          ToolTip="预览产品" />
                  <Button Style="{StaticResource SettingsListActionButtonStyle}"
                          Tag="{StaticResource SettingsEditIconGeometry}"
                          Margin="12,0,0,0"
                          Command="{Binding DataContext.OpenEditProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}"
                          ToolTip="编辑产品" />
                  <Button Style="{StaticResource SettingsListDangerButtonStyle}"
                          Tag="{StaticResource SettingsDeleteIconGeometry}"
                          Margin="12,0,0,0"
                          Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}"
                          ToolTip="删除产品" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <Grid Grid.Row="3">
        <TextBlock Text="{Binding FilteredProductCount, StringFormat=共 {0} 条}"
                   Foreground="#EAF4FF"
                   FontSize="15"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
          <Button Style="{StaticResource UnifiedPagerButtonStyle}"
                  Command="{Binding PreviousPageCommand}"
                  IsEnabled="{Binding CanGoToPreviousPage}"
                  Content="‹" />
          <TextBlock Text="{Binding PageSummary}" Width="64" Margin="8,0"
                     Foreground="#DCEAF5" FontSize="14" TextAlignment="Center" VerticalAlignment="Center" />
          <Button Style="{StaticResource UnifiedPagerButtonStyle}"
                  Command="{Binding NextPageCommand}"
                  IsEnabled="{Binding CanGoToNextPage}"
                  Content="›" />
          <TextBlock Text="每页" Margin="20,0,8,0" Foreground="#8FA9C1" FontSize="13" VerticalAlignment="Center" />
          <ComboBox Width="78" Height="34" MinHeight="34" Padding="8,4"
                    ItemsSource="{Binding PageSizeOptions}" DisplayMemberPath="Value"
                    SelectedValuePath="Value" SelectedValue="{Binding SelectedPageSize}"
                    Background="#0D2942" BorderBrush="#31465A" BorderThickness="1" />
          <TextBlock Text="条" Margin="8,0,0,0" Foreground="#8FA9C1" FontSize="13" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>
