<UserControl x:Class="OceanFresh.SortingSystem.HMI.Pages.RecipesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Border Background="{StaticResource PanelBackground}" CornerRadius="18" Padding="24">
      <StackPanel>
        <DockPanel Margin="0,0,0,18">
          <StackPanel>
            <TextBlock Text="海鲜产品列表" Foreground="{StaticResource TextBrush}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="产品列表页只预览，新增和编辑都进入独立编辑页。"
                       Foreground="{StaticResource MutedTextBrush}"
                       Margin="0,8,0,0" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
            <Button Padding="16,10"
                    Background="{StaticResource AccentBrush}"
                    Foreground="#08121B"
                    BorderThickness="0"
                    FontWeight="Bold"
                    MinWidth="140"
                    Command="{Binding OpenCreateProductCommand}">
              <TextBlock Text="新建海鲜产品" />
            </Button>
            <Button Margin="10,0,0,0"
                    Padding="16,10"
                    Background="{StaticResource SurfaceBrush}"
                    Foreground="{StaticResource TextBrush}"
                    BorderThickness="0"
                    MinWidth="108"
                    Command="{Binding RefreshCommand}">
              <TextBlock Text="刷新列表" />
            </Button>
          </StackPanel>
        </DockPanel>

        <Border Background="{StaticResource SurfaceSoftBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,18">
          <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
        </Border>

        <DataGrid ItemsSource="{Binding Products}"
                  SelectedItem="{Binding SelectedProduct}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  Background="{StaticResource SurfaceSoftBrush}"
                  Foreground="{StaticResource TextBrush}"
                  BorderThickness="0"
                  RowBackground="{StaticResource SurfaceSoftBrush}"
                  AlternatingRowBackground="{StaticResource SurfaceBrush}"
                  MinHeight="460">
          <DataGrid.Columns>
            <DataGridTextColumn Header="海鲜名称" Binding="{Binding Name}" Width="1.3*" />
            <DataGridTextColumn Header="编码" Binding="{Binding Code}" Width="*" />
            <DataGridTextColumn Header="缺陷类型" Binding="{Binding DefectTraitsDisplay}" Width="1.8*" />
            <DataGridTextColumn Header="性状数" Binding="{Binding TraitCount}" Width="0.7*" />
          </DataGrid.Columns>
        </DataGrid>

        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
          <Button Padding="18,12"
                  Background="{StaticResource AccentMutedBrush}"
                  Foreground="#08121B"
                  BorderThickness="0"
                  FontWeight="Bold"
                  MinWidth="140"
                  Visibility="{Binding HasSelectedProduct, Converter={StaticResource BoolToVisibilityConverter}}"
                  Command="{Binding OpenEditProductCommand}">
            <TextBlock Text="编辑选中产品" />
          </Button>
          <Button Margin="12,0,0,0"
                  Padding="18,12"
                  Background="{StaticResource DangerBrush}"
                  Foreground="{StaticResource TextBrush}"
                  BorderThickness="0"
                  MinWidth="116"
                  Visibility="{Binding HasSelectedProduct, Converter={StaticResource BoolToVisibilityConverter}}"
                  Command="{Binding DeleteProductCommand}">
            <TextBlock Text="删除产品" />
          </Button>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
