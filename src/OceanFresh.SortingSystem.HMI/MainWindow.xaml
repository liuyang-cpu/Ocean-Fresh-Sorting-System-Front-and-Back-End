<Window x:Class="OceanFresh.SortingSystem.HMI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OceanFresh.SortingSystem.HMI"
        xmlns:pages="clr-namespace:OceanFresh.SortingSystem.HMI.Pages"
        mc:Ignorable="d"
        Title="Ocean Fresh Sorting System"
        Height="900"
        Width="1440"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ShellBackground}"
        FontFamily="Microsoft YaHei UI">
  <Window.Resources>
    <local:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
    <local:BooleanToGridLengthConverter x:Key="BoolToGridLengthConverter" />
    <DataTemplate DataType="{x:Type pages:DashboardPageViewModel}">
      <pages:DashboardPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:UserCenterPageViewModel}">
      <pages:UserCenterPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:MonitoringPageViewModel}">
      <pages:MonitoringPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:ProductionStatisticsPageViewModel}">
      <pages:ProductionStatisticsPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:ManualReviewPageViewModel}">
      <pages:ManualReviewPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:RecipesPageViewModel}">
      <pages:RecipesPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:ProductEditorPageViewModel}">
      <pages:ProductEditorPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:ProductDetailPageViewModel}">
      <pages:ProductDetailPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:ChannelConfigsPageViewModel}">
      <pages:ChannelConfigsPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:ChannelEditorPageViewModel}">
      <pages:ChannelEditorPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:ChannelDetailPageViewModel}">
      <pages:ChannelDetailPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:ModelManagementPageViewModel}">
      <pages:ModelManagementPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:ModelImportPageViewModel}">
      <pages:ModelImportPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:ModelDetailPageViewModel}">
      <pages:ModelDetailPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:DeviceManagementPageViewModel}">
      <pages:DeviceManagementPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:EjectionSettingsPageViewModel}">
      <pages:EjectionSettingsPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:SafetyAlarmsPageViewModel}">
      <pages:SafetyAlarmsPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:SoftwareMaintenancePageViewModel}">
      <pages:SoftwareMaintenancePage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:SettingsPageViewModel}">
      <pages:SettingsPage />
    </DataTemplate>
    <Style x:Key="ShellTopButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#092036" />
      <Setter Property="Foreground" Value="#E8F3FF" />
      <Setter Property="BorderBrush" Value="#2772B0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="18,6" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Height" Value="36" />
      <Setter Property="MinWidth" Value="102" />
    </Style>
    <Style x:Key="ShellModeButtonStyle" TargetType="Button" BasedOn="{StaticResource ShellTopButtonStyle}">
      <Setter Property="Background" Value="#1263AE" />
      <Setter Property="BorderBrush" Value="#328EE8" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="Height" Value="34" />
      <Setter Property="FontSize" Value="15" />
    </Style>
  </Window.Resources>
  <Grid>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="94" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.Visibility>
        <Binding Path="IsAuthenticated" Converter="{StaticResource BoolToVisibilityConverter}" />
      </Grid.Visibility>

      <Border Background="#08253A"
              Padding="4"
              BorderBrush="#164869"
              BorderThickness="0,0,1,0"
              TextElement.FontFamily="Noto Sans SC">
        <DockPanel LastChildFill="False">
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,56">
            <Border Width="88" Height="88" CornerRadius="4" Background="#0F304C" BorderBrush="#2B648C" BorderThickness="1" HorizontalAlignment="Center">
              <StackPanel VerticalAlignment="Center" Margin="0,-6,0,0">
                <TextBlock Text="OF" Foreground="White" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Text="SORT" Foreground="#D8E8F8" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
            <TextBlock Text="海鲜分拣"
                       Foreground="#DCEBFA"
                       FontSize="14"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,0">
              <TextBlock.RenderTransform>
                <TranslateTransform Y="-7" />
              </TextBlock.RenderTransform>
            </TextBlock>
          </StackPanel>

          <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding NavigationItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Margin="0,0,0,24"
                        Padding="0"
                        Background="Transparent"
                        Foreground="{StaticResource TextBrush}"
                        BorderThickness="0"
                        Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}">
                  <Grid Width="88" Height="96">
                    <Border x:Name="NavChrome" CornerRadius="4" Background="Transparent" Opacity="1" BorderBrush="Transparent" BorderThickness="0" />
                    <Border x:Name="NavStripe" Width="0" HorizontalAlignment="Left" Background="#4CC3FF" Visibility="Collapsed" />
                    <StackPanel VerticalAlignment="Center">
                      <Border x:Name="IconChrome" Width="36" Height="36" CornerRadius="4" Background="Transparent" HorizontalAlignment="Center">
                        <TextBlock x:Name="NavIcon"
                                   Text="{Binding Icon}"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="#D8E8F7"
                                   FontSize="26"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                      </Border>
                      <TextBlock x:Name="NavTitle"
                                 Text="{Binding Title}"
                                 Foreground="#D8E8F7"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 HorizontalAlignment="Center"
                                 Margin="0,7,0,0" />
                    </StackPanel>
                  </Grid>
                </Button>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="NavChrome" Property="Background" Value="#1263AE" />
                    <Setter TargetName="NavChrome" Property="BorderBrush" Value="#328EE8" />
                    <Setter TargetName="NavChrome" Property="BorderThickness" Value="1" />
                    <Setter TargetName="IconChrome" Property="Background" Value="#2C6FA5" />
                    <Setter TargetName="NavStripe" Property="Visibility" Value="Visible" />
                    <Setter TargetName="NavIcon" Property="Opacity" Value="1" />
                    <Setter TargetName="NavTitle" Property="Foreground" Value="White" />
                    <Setter TargetName="NavTitle" Property="FontWeight" Value="Bold" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button DockPanel.Dock="Bottom"
                  Margin="0,0,0,8"
                  Padding="0"
                  Background="Transparent"
                  Foreground="{StaticResource TextBrush}"
                  BorderThickness="0"
                  Command="{Binding LogoutCommand}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Opacity" Value="0.6" />
                <Style.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <Grid Width="88" Height="72">
              <Border CornerRadius="4" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" />
              <StackPanel VerticalAlignment="Center">
                <Border Width="32" Height="32" CornerRadius="4" Background="Transparent" HorizontalAlignment="Center">
                  <TextBlock Text="&#xE8BB;"
                             FontFamily="Segoe MDL2 Assets"
                             Foreground="#D8E8F7"
                             FontSize="24"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="退出系统" Foreground="#D8E8F7" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
              </StackPanel>
            </Grid>
          </Button>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1" Margin="8,4,8,8">
        <Grid.RowDefinitions>
          <RowDefinition Height="{Binding IsSettingsWorkspace, Converter={StaticResource BoolToGridLengthConverter}}" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#0B1F34"
                CornerRadius="4"
                Padding="20,0"
                Margin="0,0,0,10"
                Height="62"
                BorderBrush="#164B70"
                BorderThickness="1"
                TextElement.FontFamily="Noto Sans SC"
                Visibility="{Binding IsSettingsWorkspace, Converter={StaticResource InverseBoolToVisibilityConverter}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="1" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding HeaderTitle}"
                       Width="180"
                       Foreground="#F3F8FC"
                       FontSize="30"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,20,0" />
            <Border Grid.Column="1"
                    Width="1"
                    Height="24"
                    Background="#123A58"
                    VerticalAlignment="Center" />
            <TextBlock Grid.Column="2"
                       Text="{Binding CurrentUserDisplay}"
                       Width="160"
                       Foreground="#B6C8DA"
                       FontSize="15"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="17,0,12,0" />
            <Button Grid.Column="3"
                    Style="{StaticResource ShellModeButtonStyle}"
                    Command="{Binding ToggleFeedbackPanelCommand}"
                    VerticalAlignment="Center">
              <TextBlock Text="批注模式" />
            </Button>
          </Grid>
        </Border>

        <Grid Grid.Row="1">
          <ContentControl Content="{Binding CurrentPage}" />

          <Border Width="360"
                  Padding="20"
                  CornerRadius="4"
                  Background="{StaticResource PanelBackground}"
                  BorderBrush="{StaticResource OutlineBrush}"
                  BorderThickness="1"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0,8,8,0"
                  Visibility="{Binding IsFeedbackPanelOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <StackPanel>
                <DockPanel>
                  <TextBlock Text="界面批注" Foreground="{StaticResource TextBrush}" FontSize="22" FontWeight="SemiBold" />
                  <Button DockPanel.Dock="Right"
                          Padding="10,6"
                          MinWidth="68"
                          Background="{StaticResource SurfaceBrush}"
                          Command="{Binding ToggleFeedbackPanelCommand}">
                    <TextBlock Text="收起" />
                  </Button>
                </DockPanel>
                <TextBlock Text="在当前页面选一个区块编号，直接把意见写下来。"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <TextBlock Text="当前页面区块" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding CurrentFeedbackTargets}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Margin="0,0,8,8"
                              Padding="12,8"
                              Background="{StaticResource SurfaceBrush}"
                              Command="{Binding DataContext.SelectFeedbackTargetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Code}" FontWeight="Bold" />
                          <TextBlock Text=" " />
                          <TextBlock Text="{Binding Label}" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Grid.Row="2" Margin="0,18,0,0">
                <TextBlock Text="{Binding FeedbackStatusMessage}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                <Border Background="{StaticResource SurfaceSoftBrush}" CornerRadius="14" Padding="14" Margin="0,12,0,12">
                  <TextBox Text="{Binding DraftFeedbackComment, UpdateSourceTrigger=PropertyChanged}"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           MinHeight="120"
                           VerticalScrollBarVisibility="Auto" />
                </Border>
                <Button Padding="16,10"
                        Background="{StaticResource AccentBrush}"
                        Foreground="#08121B"
                        FontWeight="Bold"
                        Command="{Binding SaveFeedbackCommand}">
                  <TextBlock Text="保存这条批注" />
                </Button>
              </StackPanel>

              <StackPanel Grid.Row="3" Margin="0,18,0,0">
                <TextBlock Text="最近批注" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding RecentFeedbackEntries}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{StaticResource SurfaceSoftBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,10" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1">
                          <StackPanel>
                            <TextBlock Foreground="{StaticResource TextBrush}" FontWeight="SemiBold">
                              <Run Text="{Binding TargetCode}" />
                              <Run Text=" " />
                              <Run Text="{Binding TargetLabel}" />
                            </TextBlock>
                            <TextBlock Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0">
                              <Run Text="{Binding PageTitle}" />
                              <Run Text=" · " />
                              <Run Text="{Binding CreatedAt, StringFormat={}{0:MM-dd HH:mm}}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Comment}"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseBoolToVisibilityConverter}}">
      <Grid.Background>
        <SolidColorBrush Color="#07192A" />
      </Grid.Background>
      <Border Width="640"
              Padding="52,42"
              Background="#0B2238"
              CornerRadius="4"
              BorderBrush="#245878"
              BorderThickness="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Border Width="76" Height="76" Background="#103451" BorderBrush="#327BAA" BorderThickness="1" CornerRadius="4">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="OF" Foreground="#FFFFFF" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Text="SORT" Foreground="#C8DDEE" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
            <StackPanel VerticalAlignment="Center" Margin="20,0,0,0">
              <TextBlock Text="海洋生鲜分拣系统" Foreground="#F5F9FC" FontSize="28" FontWeight="Bold" />
              <TextBlock Text="系统登录" Foreground="#8FB2CC" FontSize="16" Margin="0,6,0,0" />
            </StackPanel>
          </StackPanel>

          <Border Height="1" Background="#214A66" Margin="0,32,0,30" />

          <TextBlock Text="操作员" Foreground="#DCEAF5" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
          <Button Height="62"
                  Background="#1673BC"
                  BorderBrush="#3CA3EE"
                  BorderThickness="1"
                  Foreground="#FFFFFF"
                  FontSize="19"
                  FontWeight="Bold"
                  Command="{Binding LoginAsOperatorCommand}">
            <TextBlock Text="操作员登录" />
          </Button>

          <Grid Margin="0,26,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="176" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="管理员密码" Foreground="#DCEAF5" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
              <Border Height="62" Background="#081B2C" CornerRadius="4" Padding="18,0" BorderBrush="#356785" BorderThickness="1">
                <PasswordBox x:Name="AdminLoginPasswordBox"
                             PasswordChanged="AdminLoginPasswordBox_OnPasswordChanged"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#F3F8FC"
                             CaretBrush="#4CC3FF"
                             FontSize="20"
                             VerticalContentAlignment="Center" />
              </Border>
            </StackPanel>
            <Button Grid.Column="2"
                    Height="62"
                    Margin="0,37,0,0"
                    VerticalAlignment="Top"
                    Background="#102C43"
                    Foreground="#E8F2FA"
                    BorderBrush="#3A718F"
                    BorderThickness="1"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Command="{Binding LoginAsAdminCommand}">
              <TextBlock Text="管理员登录" />
            </Button>
          </Grid>

          <TextBlock Text="{Binding LoginStatusMessage}"
                     Foreground="#FFB24A"
                     FontSize="15"
                     TextWrapping="Wrap"
                     HorizontalAlignment="Center"
                     Margin="0,20,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
