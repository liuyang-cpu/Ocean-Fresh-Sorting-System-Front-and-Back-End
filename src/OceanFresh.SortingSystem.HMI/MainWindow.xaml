<Window x:Class="OceanFresh.SortingSystem.HMI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OceanFresh.SortingSystem.HMI"
        xmlns:pages="clr-namespace:OceanFresh.SortingSystem.HMI.Pages"
        mc:Ignorable="d"
        Title="Ocean Fresh Sorting System"
        Height="900"
        Width="1440"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ShellBackground}">
  <Window.Resources>
    <local:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
    <DataTemplate DataType="{x:Type pages:DashboardPageViewModel}">
      <pages:DashboardPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:MonitoringPageViewModel}">
      <pages:MonitoringPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:RecipesPageViewModel}">
      <pages:RecipesPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:ProductEditorPageViewModel}">
      <pages:ProductEditorPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:ChannelConfigsPageViewModel}">
      <pages:ChannelConfigsPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:ChannelEditorPageViewModel}">
      <pages:ChannelEditorPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:ChannelDetailPageViewModel}">
      <pages:ChannelDetailPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:ModelManagementPageViewModel}">
      <pages:ModelManagementPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:ModelImportPageViewModel}">
      <pages:ModelImportPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:SettingsPageViewModel}">
      <pages:SettingsPage />
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.Visibility>
        <Binding Path="IsAuthenticated" Converter="{StaticResource BoolToVisibilityConverter}" />
      </Grid.Visibility>

      <Border Background="#101F30" Padding="20">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Ocean Fresh" Foreground="{StaticResource TextBrush}" FontSize="26" FontWeight="Bold" />
            <TextBlock Text="海洋生鲜分拣系统" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,28" />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding NavigationItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Margin="0,0,0,12"
                        Padding="16,14"
                        Background="{StaticResource SurfaceSoftBrush}"
                        Foreground="{StaticResource TextBrush}"
                        BorderThickness="0"
                        FontSize="16"
                        Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}">
                  <TextBlock Text="{Binding Title}" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1" Margin="20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBackground}" CornerRadius="18" Padding="20" Margin="0,0,0,16">
          <DockPanel>
            <StackPanel>
              <TextBlock Text="{Binding HeaderTitle}" Foreground="{StaticResource TextBrush}" FontSize="28" FontWeight="Bold" />
              <TextBlock Text="{Binding HeaderSubtitle}" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" />
              <Border Background="{StaticResource SurfaceSoftBrush}" CornerRadius="12" Padding="12,8" Margin="0,12,0,0">
                <TextBlock Text="{Binding FeedbackHint}"
                           Foreground="{StaticResource TextBrush}"
                           TextWrapping="Wrap" />
              </Border>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Border Background="{StaticResource SurfaceSoftBrush}" CornerRadius="20" Padding="18,10" Margin="0,0,12,0">
                <TextBlock Text="{Binding CurrentUserDisplay}" Foreground="{StaticResource TextBrush}" />
              </Border>
              <Button Margin="12,0,0,0"
                      Padding="18,10"
                      Background="{StaticResource AccentMutedBrush}"
                      Foreground="#08121B"
                      BorderThickness="0"
                      Command="{Binding ToggleFeedbackPanelCommand}">
                <TextBlock Text="批注模式" />
              </Button>
              <Button Margin="12,0,0,0"
                      Padding="18,10"
                      Background="{StaticResource SurfaceBrush}"
                      Foreground="{StaticResource TextBrush}"
                      BorderThickness="0"
                      Command="{Binding LogoutCommand}">
                <TextBlock Text="退出登录" />
              </Button>
            </StackPanel>
          </DockPanel>
        </Border>

        <Grid Grid.Row="1">
          <ContentControl Content="{Binding CurrentPage}" />

          <Border Width="360"
                  Padding="20"
                  CornerRadius="18"
                  Background="{StaticResource PanelBackground}"
                  BorderBrush="{StaticResource OutlineBrush}"
                  BorderThickness="1"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0,8,8,0"
                  Visibility="{Binding IsFeedbackPanelOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <StackPanel>
                <DockPanel>
                  <TextBlock Text="界面批注" Foreground="{StaticResource TextBrush}" FontSize="22" FontWeight="SemiBold" />
                  <Button DockPanel.Dock="Right"
                          Padding="10,6"
                          MinWidth="68"
                          Background="{StaticResource SurfaceBrush}"
                          Command="{Binding ToggleFeedbackPanelCommand}">
                    <TextBlock Text="收起" />
                  </Button>
                </DockPanel>
                <TextBlock Text="在当前页面选一个区块编号，直接把意见写下来。"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <TextBlock Text="当前页面区块" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding CurrentFeedbackTargets}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Margin="0,0,8,8"
                              Padding="12,8"
                              Background="{StaticResource SurfaceBrush}"
                              Command="{Binding DataContext.SelectFeedbackTargetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Code}" FontWeight="Bold" />
                          <TextBlock Text=" " />
                          <TextBlock Text="{Binding Label}" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Grid.Row="2" Margin="0,18,0,0">
                <TextBlock Text="{Binding FeedbackStatusMessage}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                <Border Background="{StaticResource SurfaceSoftBrush}" CornerRadius="14" Padding="14" Margin="0,12,0,12">
                  <TextBox Text="{Binding DraftFeedbackComment, UpdateSourceTrigger=PropertyChanged}"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           MinHeight="120"
                           VerticalScrollBarVisibility="Auto" />
                </Border>
                <Button Padding="16,10"
                        Background="{StaticResource AccentBrush}"
                        Foreground="#08121B"
                        FontWeight="Bold"
                        Command="{Binding SaveFeedbackCommand}">
                  <TextBlock Text="保存这条批注" />
                </Button>
              </StackPanel>

              <StackPanel Grid.Row="3" Margin="0,18,0,0">
                <TextBlock Text="最近批注" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding RecentFeedbackEntries}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{StaticResource SurfaceSoftBrush}" CornerRadius="14" Padding="12" Margin="0,0,0,10">
                          <StackPanel>
                            <TextBlock Foreground="{StaticResource TextBrush}" FontWeight="SemiBold">
                              <Run Text="{Binding TargetCode}" />
                              <Run Text=" " />
                              <Run Text="{Binding TargetLabel}" />
                            </TextBlock>
                            <TextBlock Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0">
                              <Run Text="{Binding PageTitle}" />
                              <Run Text=" · " />
                              <Run Text="{Binding CreatedAt, StringFormat={}{0:MM-dd HH:mm}}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Comment}"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseBoolToVisibilityConverter}}">
      <Grid.Background>
        <SolidColorBrush Color="#0B1724" Opacity="0.98" />
      </Grid.Background>
      <Border Width="520"
              Padding="36"
              Background="{StaticResource PanelBackground}"
              CornerRadius="24"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="Ocean Fresh" Foreground="White" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" />
          <TextBlock Text="海洋生鲜分拣系统登录"
                         Foreground="{StaticResource MutedTextBrush}"
                     FontSize="18"
                     HorizontalAlignment="Center"
                     Margin="0,12,0,28" />

          <Border Background="{StaticResource SurfaceSoftBrush}" CornerRadius="18" Padding="22" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="操作员" Foreground="White" FontSize="24" FontWeight="SemiBold" />
              <TextBlock Text="适合现场启停设备、查看检测监控、确认告警和切换产品。"
                         Foreground="{StaticResource MutedTextBrush}"
                         Margin="0,10,0,16"
                         TextWrapping="Wrap" />
              <Button Padding="14"
                      Background="{StaticResource AccentBrush}"
                      Foreground="#08121B"
                      BorderThickness="0"
                      FontWeight="Bold"
                      Command="{Binding LoginAsOperatorCommand}">
                <TextBlock Text="以操作员身份进入" />
              </Button>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource SurfaceSoftBrush}" CornerRadius="18" Padding="22">
            <StackPanel>
              <TextBlock Text="管理员" Foreground="White" FontSize="24" FontWeight="SemiBold" />
              <TextBlock Text="适合管理模型版本、剔除规则、系统设置和用户权限。"
                         Foreground="{StaticResource MutedTextBrush}"
                         Margin="0,10,0,16"
                         TextWrapping="Wrap" />
              <Button Padding="14"
                      Background="{StaticResource AccentMutedBrush}"
                      Foreground="#08121B"
                      BorderThickness="0"
                      FontWeight="Bold"
                      Command="{Binding LoginAsAdminCommand}">
                <TextBlock Text="以管理员身份进入" />
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
